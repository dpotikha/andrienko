[
    {
        "id": "name:a5e67ade99775ab1e13678f6ae4c19a0",
        "text": "Виктор Андриенко"
    },
    {
        "id": "name:9afcd62d60fc8ff4bfd7df1d6c8aa854",
        "text": "Остров Сокровищ"
    },
    {
        "id": "name:73fa7d846593b1d7e8197fee1c673e16",
        "text": "Настройки сайта"
    },
    {
        "id": "name:69df1f85b0abbce850b5feb29bddcb2a",
        "text": "Новости"
    },
    {
        "id": "name:c80b526f5c7008e7ee1c3495033b2115",
        "text": "И это всё о нем"
    },
    {
        "id": "name:5a34e5446905d8389a6dc403bdb76b72",
        "text": "Фото"
    },
    {
        "id": "name:d7cdbc19021fb9eec893a7e147fed6bf",
        "text": "Публикации"
    },
    {
        "id": "name:1071806f2bad571d7635646a5236fe57",
        "text": "Друзья и партнеры"
    },
    {
        "id": "name:daf094175c2dbaed3aed7e4cd6396530",
        "text": "Байки посмихайки"
    },
    {
        "id": "name:90fbbbb6341b4ec92979aae5d45b01ff",
        "text": "Тыци - Дрыци - Ерундыци"
    },
    {
        "id": "name:a5c79a25feadcfcea27eabb58758d3f9",
        "text": "9 жизней Нестора Махно"
    },
    {
        "id": "name:3e1a0849f7957b337a67cfe6de9c7883",
        "text": "Студенческие работы"
    },
    {
        "id": "name:e29a76c8b14b32c419037334cf0c1167",
        "text": "Ноты и банкноты"
    },
    {
        "id": "name:873d685696bc8392d13ce2ff937d0860",
        "text": "Полное Мамаду - 1 сезон"
    },
    {
        "id": "name:6433536a59b82c685a64bd09e14221f7",
        "text": "Полное Мамаду – 2 сезон"
    },
    {
        "id": "name:ae902dd35dbb9c1743efee5dd5f61b74",
        "text": "Шоу довгоносиків - 1 сезон"
    },
    {
        "id": "name:0c11e0260dc6a9fc1e888addfa200152",
        "text": "Репортаж"
    },
    {
        "id": "name:fe4a9dc0f76e8aac9b459ae972fe37db",
        "text": "Магдебургские хроники"
    },
    {
        "id": "name:935425038bf63d7fb31e8f37b3160e4a",
        "text": "Прем'єра"
    },
    {
        "id": "name:fe7d640b4851aecf80834f236f3bca8d",
        "text": "Жозефина или мышиный народ"
    },
    {
        "id": "name:24a2a3d77f1223e5e2b54c54264cb64e",
        "text": "Сердца трех – 2"
    },
    {
        "id": "name:4d7371a713ebfd20c7c52f01f0cff1cb",
        "text": "Империя пиратов"
    },
    {
        "id": "name:0f1661c611516642e7b514b5461d2b21",
        "text": "Веселые Байки"
    },
    {
        "id": "name:d95239dd4f3bcaf0aa5aec24925c4261",
        "text": "Один в Новогоднюю ночь"
    },
    {
        "id": "name:15fe41b3b4338e57fffc61e2ada36c6e",
        "text": "Веселая Хата - 2 сезон"
    },
    {
        "id": "name:b95746f5604143c4a733409b84f4ffe9",
        "text": "Радио"
    },
    {
        "id": "name:e1335ae9069b93d58702d27d28eb2c4d",
        "text": "Хит-фабрика"
    },
    {
        "id": "name:cebf21f97d66cbcefd35ee260399cc0c",
        "text": "Комедийный квартет"
    },
    {
        "id": "name:3206183278bc7d6cc32e153bee9d8100",
        "text": "\"Хто боїться дядечку БАБАЯ?\""
    },
    {
        "id": "name:66ec103d50d31e61289851bc4cf79f21",
        "text": "Ограбление в новогоднюю ночь"
    },
    {
        "id": "name:c62387200f184d67b9c3ee728c2ac3b8",
        "text": "Гадюкины Рекордс"
    },
    {
        "id": "name:1a63f51d00615f5ea96527ef2f23b10b",
        "text": "Пляжный клуб или йо – моё"
    },
    {
        "id": "name:ef86bb3fbb3e19b0d040119f341e95c7",
        "text": "Безумные макароны"
    },
    {
        "id": "name:40101e94d0da81ba869c836812180a34",
        "text": "Остров сокровищ"
    },
    {
        "id": "name:c6ddcc2e5a20377a23f5ba32e12bb3bf",
        "text": "Тихий ужас"
    },
    {
        "id": "name:974fc40bb1d3dd82c44229ac90d790f2",
        "text": "Канкан в английском парке"
    },
    {
        "id": "name:64b49718fb4a418bf583af824a21e327",
        "text": "Подвиг Одессы"
    },
    {
        "id": "name:6f8ab1af480133ad47742db319ad53f9",
        "text": "Столкновение"
    },
    {
        "id": "name:0a8854beb0f8fd0c99a0035cb0f09d83",
        "text": "В двух шагах от рая"
    },
    {
        "id": "name:ef9b256bad44e3580e7ae6bdb31107cb",
        "text": "Диалоги с совестью"
    },
    {
        "id": "name:5997e5c9098bab2d9aa1cc24a489fbc0",
        "text": "Мужчины есть мужчины"
    },
    {
        "id": "name:f6f75be2b1b242ec7fa7d1eabfbc7472",
        "text": "Поезд вне расписания"
    },
    {
        "id": "name:f773ce3571ca2b82c1f2f8bf9a72ca50",
        "text": "ДОН ЖУАН"
    },
    {
        "id": "name:f8f4c3320a7a5f734dd4e9059e872c84",
        "text": "Дети капитана Гранта"
    },
    {
        "id": "name:d5a3f40aed84b1df710477783064a260",
        "text": "Морские приключения"
    },
    {
        "id": "name:ca8195cb60e5b4b189739c86dadca222",
        "text": "Дымка"
    },
    {
        "id": "name:5cf9eb8ecf8e4e2693c2b9bfda106582",
        "text": "Рядом с вами"
    },
    {
        "id": "name:09973a39ae975caa2a1eacfde16c5781",
        "text": "«Похождения бравого солдата Швейка»"
    },
    {
        "id": "name:fc4b810465bbd00be272d0d8d0df357e",
        "text": "Последний бой"
    },
    {
        "id": "name:5c1bc60e647901ff940931cbfceb9c21",
        "text": "Одесский Театр «Гротеск»"
    },
    {
        "id": "name:f4dfd5a15b179594c50e7324bb8284d6",
        "text": "Трест, который лопнул"
    },
    {
        "id": "name:dffdc84c6fed032d5a80d8f64328b24b",
        "text": "Возвращение с орбиты"
    },
    {
        "id": "name:8e781c0373bd6d78f07916c0e20c53e5",
        "text": "Гостья из будущего"
    },
    {
        "id": "name:902fd5a271600e64b27b340e807bc3f8",
        "text": "Бессмертие"
    },
    {
        "id": "name:9af6ce810e5bdb6627ed19c89d12b9fc",
        "text": "Иванко и царь Поганин"
    },
    {
        "id": "name:0275c999b0866e15c77c949d19290dc7",
        "text": "Вспомните – это важно"
    },
    {
        "id": "name:f8a0edc0785225bdb22eb2adeb9ad87a",
        "text": "Третий в девятом ряду"
    },
    {
        "id": "name:7023b52ba05c473bd595e481971441d4",
        "text": "Сергей Лазо"
    },
    {
        "id": "name:8924a224846e3d77ef9fe5bd89d728cc",
        "text": "Дачная поездка сержанта Цыбули"
    },
    {
        "id": "name:6fa527be855118062eea08dfda5a29c8",
        "text": "Безумные Макароны или Ошибка профессора Бугенсберга"
    },
    {
        "id": "name:22e41b08e7fda38bad3fd6db4d5ccc7b",
        "text": "Вася Бендас"
    },
    {
        "id": "name:5027c64963e6e75fdfa13573f6f368fa",
        "text": "Алексей Вертинский"
    },
    {
        "id": "name:e81fef8777d3801aaae4dc413322a370",
        "text": "Юрий Стыцковский предложил Андриенко миллион..."
    },
    {
        "id": "name:7c2f366e8d21aa345806254fe1fd1d26",
        "text": "Баллада о доблестном рыцаре Айвенго"
    },
    {
        "id": "name:66ea47d0f83d8d2e443402f3beac84a8",
        "text": "Великі перегони"
    },
    {
        "id": "name:5e655487d60914fe0895293ad55f14d1",
        "text": "Шоу довгоносиків - 4 сезон"
    },
    {
        "id": "name:00e7449456d99e5e591ac23f3dbf96e0",
        "text": "Полное Марабу"
    },
    {
        "id": "name:9beb69aadd405f56f54a2fa4cc7738dc",
        "text": "Комик - группа «Шарж»"
    },
    {
        "id": "name:9439e1d7b271fc0585b74bb5ad967a8e",
        "text": "Киевский Театр эстрады"
    },
    {
        "id": "name:0d1e0cd7fc49966f197e742af2f30e95",
        "text": "Начало"
    },
    {
        "id": "name:6fe12c410cf0581f1180a137998d7126",
        "text": "До відома громадян, на честь десятиріччя з дня народження телепередачі \"Шоу довгоносиків\", відкрився міжнародний клюб любителів довгоносиків."
    },
    {
        "id": "name:c0fc288404652b5264692bc8ca9b1fa9",
        "text": "Милицейская академия – 2 сезон"
    },
    {
        "id": "name:a4cb1afcc96d2e257a88b4a8e19b4595",
        "text": "Присяжный поверенный"
    },
    {
        "id": "name:554dd7c189d6ac896074b9499e64b11d",
        "text": "Школа выживания с Сергеем Сивохой"
    },
    {
        "id": "name:111420b535cbe6dcb19202a770b2c45f",
        "text": "Веселая хата - 1 сезон"
    },
    {
        "id": "name:c43f1d272345d75c133d17c16202c55b",
        "text": "Шоу довгоносиків - 2 сезон"
    },
    {
        "id": "name:dff2fc0c59f4271365ad44abc390c3b4",
        "text": "Шоу довгоносиків - 3 сезон"
    },
    {
        "id": "name:d5611d93520193d9ddffb5aaac040d5c",
        "text": "На белом катере…"
    },
    {
        "id": "name:cd138a989bd8d3925aad7c32dece1a02",
        "text": "Между первой и второй"
    },
    {
        "id": "name:2f83346d2f04711382670b29003d72c5",
        "text": "Милицейская академия - 1 сезон"
    },
    {
        "id": "name:611a27f98e66b4af523f8ace2b32b7d2",
        "text": "Комедийный коктейль – 3 сезон"
    },
    {
        "id": "name:6dccbc7bb7361e9c29d43e8ea50c0cfa",
        "text": "Дружная семейка – 4 сезон"
    },
    {
        "id": "name:d46a824ad77821dd5d64bc4786e1a909",
        "text": "Комедийный коктейль – 2 сезон"
    },
    {
        "id": "name:9341923741b433cd911418b142f88f73",
        "text": "Шум ветра"
    },
    {
        "id": "name:bf31205dbbaabf548749cdcb90ed0151",
        "text": "Дружная семейка – 3 сезон"
    },
    {
        "id": "name:badcff524eb6b1d86b9182f717bf4896",
        "text": "Юрий Стыцковский"
    },
    {
        "id": "name:a12231b0ded2de62689bc370bfdf3f28",
        "text": "Дружная семейка – 2 сезон"
    },
    {
        "id": "name:26de4b7597214f7ec36f4da91da4e2a1",
        "text": "Комедийный коктейль - 1 сезон"
    },
    {
        "id": "name:92ba150c09b3f9f0bfd98bd303e7b047",
        "text": "Приватная милиция – 2 сезон"
    },
    {
        "id": "name:74b5d930dcdc4847793e9b3995107c47",
        "text": "Дружная семейка - 1 сезон"
    },
    {
        "id": "name:7a68ea53546d21486d59ee6cd9d5e7e3",
        "text": "Приватная милиция -1 сезон"
    },
    {
        "id": "name:75768c49c24662cc4465237b0731e1ce",
        "text": "Контакты"
    },
    {
        "id": "name:af2d27e5a2fc604bf9f867a71ab5c442",
        "text": "Деятельность"
    },
    {
        "id": "name:53646d69507576aa640ed17bca8931de",
        "text": "Кино"
    },
    {
        "id": "name:50aa9d699db95c6acec1c72ff77e8fd7",
        "text": "Телевидение"
    },
    {
        "id": "name:14bbc15e7caecd9bf825db25ce43d4c3",
        "text": "Мультфильмы"
    },
    {
        "id": "name:517e9f5c5261eb55842892248b98024c",
        "text": "Сцена"
    },
    {
        "id": "name:6e96822f3dc2bc8d5b5e5fc606878480",
        "text": "Шоу долгоносиков"
    },
    {
        "id": "name:27d1fde4a490ef65a16102c572689bc3",
        "text": "Полное мамаду"
    },
    {
        "id": "name:24746b36a8901474ace888e29e1b5ec0",
        "text": "Команда Эквитес"
    },
    {
        "id": "name:d87b3db78b36e378c144cc67b6eb6a11",
        "text": "Новые приключения Шерлока Холмса и доктора Ватсона"
    },
    {
        "id": "name:3c23ed278b1b438ae82f80537c72c1d0",
        "text": "Шанс с Виктором Андриенко"
    },
    {
        "id": "name:c008a8fab0c9c3d127af94c342b3a78f",
        "text": "Веселая хата"
    },
    {
        "id": "name:2502828aa1c07830cb32f33608d8c3eb",
        "text": "Доктор Айболит"
    },
    {
        "id": "name:c2ef4dceccf0b1cc2283389cd76a8c60",
        "text": "Али-Баба и сорок разбойников"
    },
    {
        "id": "name:1d9ffdd99e1b84dee8d5a8f15f3742a4",
        "text": "Милицейская академия - 1"
    },
    {
        "id": "name:baa72144f88b741050058532b8ffb717",
        "text": "Комедийный коктейль"
    },
    {
        "id": "name:b383dc8bcf3cfdc539ddebae933687d0",
        "text": "Дружная семейка"
    },
    {
        "id": "name:585b4a2dbe34616244c5bbb6448ca953",
        "text": "Климко"
    },
    {
        "id": "name:5645ef043c3c7e140971aad4efefd374",
        "text": "Зона риска"
    },
    {
        "id": "name:d6d075cb261ed605b8d9d96e3e394d24",
        "text": "Вечера на хуторе близ Диканьки"
    },
    {
        "id": "name:689bdd6db4dd1402a91ea357d4864cc2",
        "text": "Старосветские помещики"
    },
    {
        "id": "name:09cfd80e866c023a6603eccc880b4ab6",
        "text": "На вес золота"
    },
    {
        "id": "name:0098edd2cad894512631f2584ff5f72a",
        "text": "Преодоление"
    },
    {
        "id": "name:c503566fa260671d5ab570c760ee0eb6",
        "text": "Легенда о княгине Ольге"
    },
    {
        "id": "name:c5504f75e9dfe8032783926f416578dc",
        "text": "Один в новогоднюю ночь"
    },
    {
        "id": "name:b453221b6a898c4273c93684d7c2690c",
        "text": "Милицейская академия - 2"
    },
    {
        "id": "name:54ebf646aa966284120d46433574260e",
        "text": "Полное марабу"
    },
    {
        "id": "name:9d81e08402623242c1a58e1d9f20ad07",
        "text": "Приватная милиция"
    },
    {
        "id": "name:61cb1514420f1b3a500f1ba4255542a2",
        "text": "Звезда и смерть Хоакина Мурьетты"
    },
    {
        "id": "name:c008b74092a1ef8f687ae59a1a77c900",
        "text": "Репортаж на память"
    },
    {
        "id": "name:c611927cf66396ce3019c2aeae204ff4",
        "text": "Если враг не сдается…"
    },
    {
        "id": "name:456fe86aecb00275d0a05d8a95823aea",
        "text": "Ярослав Мудрый"
    },
    {
        "id": "name:6288321ecc3fa95e3adc5f6be7082d41",
        "text": "Житие святых сестер"
    },
    {
        "id": "name:ad841ad5894cacd9514c3aeee965bae7",
        "text": "Бой на перекрестке"
    },
    {
        "id": "name:17fd54768153e057593e7c7237191c4a",
        "text": "Шурочка"
    },
    {
        "id": "name:40d267774c3a8c7c87f6f2adbf75fb8a",
        "text": "Шестой"
    },
    {
        "id": "name:4419c34485a2769ac6d05f26bb25d7cc",
        "text": "Там на неведомых дорожках..."
    },
    {
        "id": "name:69dc717769755ca19da55bc44af01525",
        "text": "Грачи"
    },
    {
        "id": "name:19d7dd384a430ce9cb8696ee860701fc",
        "text": "Кремлевские курсанты"
    },
    {
        "id": "name:0cf0e825ff14860821acb313e0d1bb6f",
        "text": "Ночь коротка"
    },
    {
        "id": "name:ce2968f80c176f6ee6d198cfd7556305",
        "text": "Предупреждение"
    },
    {
        "id": "name:9278ea1130698c7724b2b92398a2f5a8",
        "text": "Амулет"
    },
    {
        "id": "name:f9acb4d9af9d0bac1a0931bac2f49a90",
        "text": "Закажите песню"
    },
    {
        "id": "name:bd31b4c100c87babaef92a030be09aa9",
        "text": "Копилка"
    },
    {
        "id": "name:9a4715fc45ac4340e6c8b7e1e11c38f3",
        "text": "Женщины шутят всерьез…"
    },
    {
        "id": "name:fffc1a3be5d0b63089d5fa349c4a036e",
        "text": "Дочь командира"
    },
    {
        "id": "name:e552eb4b2d7dfa11538c9ba11a82c7b7",
        "text": "Шальная пуля"
    },
    {
        "id": "name:a09f10c4547364e1e0e0d6099440eeb0",
        "text": "Дачная поездка сержанта Цибули"
    },
    {
        "id": "name:604c13aab51a19342cce6a15c0a1ff89",
        "text": "Свадебный венок"
    },
    {
        "id": "name:fa5df5e949d2c4e028cb768ea9938072",
        "text": "Поездка через город"
    },
    {
        "id": "name:bab95abbf9c59ef46d4a33b857a3c9ff",
        "text": "Поезда революции"
    },
    {
        "id": "name:5cc23968635f12f11d8032a749b1fed9",
        "text": "Смотрины"
    },
    {
        "id": "name:93e8f442fe0f2011f9d2386b4fe56e04",
        "text": "Старому извращенцу можно доверять"
    },
    {
        "id": "name:ef81f08f81f130674fe36f071431694d",
        "text": "Андриенко - каскадер"
    },
    {
        "id": "name:4120e23ce3a62806f4169f408ed1f590",
        "text": "Прапорщик Половинко и его питомцы..."
    },
    {
        "id": "name:228b8475755668576558dc826dc48cfb",
        "text": "Свин из мультика \"Рога и копыта\" решил разговаривать голосом Виктора Андриенко"
    },
    {
        "id": "name:d689c6fab7089ac7fe8b3e8fff2ee046",
        "text": "Голосом Виктора Андриенко будут говорить персонажи Ярослава Гашека"
    },
    {
        "id": "name:c17d7ad08c105e3a4c242afb4ec8dc34",
        "text": "«Я не делаю того, что мне не нравится»"
    },
    {
        "id": "name:6323a5caaae2a7d0f5aa79111a356b42",
        "text": "«Не считаю себя хорошим режиссером, я - талантливый актер»"
    },
    {
        "id": "name:3b7023402cba6336a2ee7d1c0d4c9c64",
        "text": "«Свой дом называю пентхаузом…»"
    },
    {
        "id": "name:b5548e5038acffc1c4801f9787468244",
        "text": "Для «своих» Андриенко построил «Веселу хату»"
    },
    {
        "id": "name:7804d668bbceff3a73960772c9abc418",
        "text": "Георгий Делиев"
    },
    {
        "id": "name:90bfca38db7b2f7487a5dc2000320505",
        "text": "Владимир Данилец и Владимир Моисеенко"
    },
    {
        "id": "name:27d5d5a08113ea5ee87d23edfb757597",
        "text": "«Долгоносики» навсегда"
    },
    {
        "id": "name:9756af726be03a06613441952611c5fd",
        "text": "Манго-Манго"
    },
    {
        "id": "name:0539a952967e38f692818aaae933f135",
        "text": "Новый  год в арене!"
    },
    {
        "id": "name:08bbe4418a9f6b6e9500bbed41e0775a",
        "text": "Виктор Андриенко: «Актерская фантазия нужна в любом деле, если вы хотите делать его хорошо»"
    },
    {
        "id": "name:e45633d7bc585684138ad9adb9f55ab1",
        "text": "Кинокомпания \"Паноптикум\" готовит веселую историю о Новогодних приключениях в супермаркете"
    },
    {
        "id": "name:6501fee9bd6b9a7038ffa7faaa5590fb",
        "text": "Фильмография и телепроекты"
    },
    {
        "id": "name:2b24c0dfc051cd685b95146af90b8bbb",
        "text": "У истоков человечества…"
    },
    {
        "id": "name:e37fbb2fbb7a24de5dd1f05449e25970",
        "text": "Не плачь, девчонка"
    },
    {
        "id": "name:8e506b495a2ab31f627b4ab0b84d3078",
        "text": "Владимир Комаров"
    },
    {
        "id": "name:b9659a091504b3bb0497d328237da021",
        "text": "«В свои 40 лет я чувствую себя двадцатилетним»"
    },
    {
        "id": "name:ed780b0b207861ac7cfe60359312c0d6",
        "text": "Длинные носы на радиоволнах"
    },
    {
        "id": "name:d838389f7df07ba4e13752dfdb71bded",
        "text": "Большая разница по одесски"
    },
    {
        "id": "name:7aa0aca9ad45494d64e73220212fcde2",
        "text": "Певица Жозефина или мышиный народ"
    },
    {
        "id": "name:ead11ccde9934c13988e447348005260",
        "text": "Полное Мамаду - 2"
    },
    {
        "id": "name:0b15bb69177fb0c8a0033031e6c74070",
        "text": "Внимание, премьера!"
    },
    {
        "id": "name:eab89b0cf7fa7e254b7161e4a5413b97",
        "text": "На эстраде"
    },
    {
        "id": "name:631532af022cf84d8e5380212c2bb5fd",
        "text": "Актер Виктор Андриенко: \"Я принципиально не занимаюсь политикой\""
    },
    {
        "id": "name:4ebb362ae18aec97e55794307c62fe83",
        "text": "Давид Черкасский"
    },
    {
        "id": "name:6f2721389f14ab3ebbb57ee6e8b1c320",
        "text": "Поезда Революции"
    },
    {
        "id": "name:df095cbbe9417a768ca294fc85d1474c",
        "text": "Георгий Конн"
    },
    {
        "id": "name:fbfbeb8379b663b06e747735e58060de",
        "text": "А ось тут - подарунок від добрих людей з КЛЮБУ ЛЮБИТЕЛІВ ДОВГОНОСИКІВ!"
    },
    {
        "id": "name:529e20e618870def2bbcde48c30fc40d",
        "text": "Там - на неведомых дорожках"
    },
    {
        "id": "name:b118ba491b29fb39ca2ad5b4186b73ea",
        "text": "Владимир Зеленский"
    },
    {
        "id": "name:ed6000396330092ce97aac37592f8556",
        "text": "Готовится к выходу компьютерная игра «Капитан Врунгель»"
    },
    {
        "id": "name:6c17ca7f0ed59421c83376e54869fe95",
        "text": "Вышла в свет компьютерная игра «Остров сокровищ»"
    },
    {
        "id": "name:cdfbe138066eabc97bc4d0de2da1b516",
        "text": "Радна Сахалтуев"
    },
    {
        "id": "name:4d49f32dcc933396c801e2d2c57ba194",
        "text": "Владимир Быстряков"
    },
    {
        "id": "name:744265626a762debffeca8d82713fae8",
        "text": "Виктор Приходько"
    },
    {
        "id": "name:348109b40208a4970cf48e2b9d26dac4",
        "text": "Валентин Опалев"
    },
    {
        "id": "name:275fca23fe1f129e9148864565f71287",
        "text": "У Василия Бендоса ДЕНЬ РОЖДЕНИЯ!"
    },
    {
        "id": "name:a579be803ed521066ec24eddbaee3fc3",
        "text": "Белорусским сябрам украинский МЕНТалитет"
    },
    {
        "id": "name:dee48a21224f3698ed316aba5e087c96",
        "text": "А ось тут - подарунок від добрих людей з КЛЮБУ ЛЮБИТЕЛІВ МАМАДУ!"
    },
    {
        "id": "name:5c18758af83fecd1ca8affb185b3bb78",
        "text": "Шоу Шепелявых - UA"
    },
    {
        "id": "name:95d7658ab627cf186545d6cb3a29f5a0",
        "text": "Гарик Кричевский"
    },
    {
        "id": "name:1c7166a0cb23a21270cff096e312a059",
        "text": "Ани Лорак"
    },
    {
        "id": "name:494fac5317784923401629640681eada",
        "text": "Николай Луценко"
    },
    {
        "id": "name:711a2e72ea754c8f4d2f1332914c31e3",
        "text": "Не прошло и полгода..."
    },
    {
        "id": "name:c225308be55f56e04971f3fe3326f4dc",
        "text": "Хит фабрика - 2 сезон"
    },
    {
        "id": "name:caa67e6059ab670b61f6bb736774b46e",
        "text": "Милицейская академия - 3 сезон"
    },
    {
        "id": "name:605f65de6e620e01e0ce3c47d9632325",
        "text": "Хит фабрика - 1 сезон"
    },
    {
        "id": "name:05683fed10b7471f542a42ecfe89fac1",
        "text": "Лото Забава - 1 сезон"
    },
    {
        "id": "name:610dbd0cfa3d09f67bc921a5f2b14240",
        "text": "Лото Забава - 2 сезон"
    },
    {
        "id": "name:4c5ff898873a3deb341f1f29f36aac26",
        "text": "Лото Забава - 3 сезон"
    },
    {
        "id": "name:cc6e583d95a15457006f63c1b87a8db9",
        "text": "КИНОБРАТСТВО"
    },
    {
        "id": "name:ff8ac8f4a4b17a75ad236bda2ca5468d",
        "text": "Общая картина была красивой"
    },
    {
        "id": "name:2bab80f94e022133d927e2fbd75379c3",
        "text": "Лото Забава"
    },
    {
        "id": "name:68e73726176c9dce457a7d723843cb33",
        "text": "Байки посміхайкі"
    },
    {
        "id": "name:0e0277ca135ac2a82832d3e760ee8cc4",
        "text": "В Запорожье с 20.03-25.03 прошел ІХ Международный фестиваль “Студенческие шутки - 2007”..."
    },
    {
        "id": "name:b7817fbac4026475414e3ec4782bf3cc",
        "text": "Эксклюзивное интервью с ветераном жюри международного фестиваля \"СТУДЕНЧЕСКИЕ ШУТКИ - 2007\"  - Виктором Андриенко."
    },
    {
        "id": "name:8d50dc496069a13a04c00da2825e5fe4",
        "text": "В Запорожье стартовал первый этап Чемпионата Украины по экстремальному автокроссу «Гонки на выживание»"
    },
    {
        "id": "name:d729bd0fb283ebf0d21dea8a87d9b57c",
        "text": "Одесская логика"
    },
    {
        "id": "name:f684f0ab9a28485042a84720129611f8",
        "text": "Виктор Андриенко выполнил заказ батьки Махно"
    },
    {
        "id": "name:f623d5f94ec8246f66ef5e417424f1ca",
        "text": "Виктор Андриенко на съемочной площадке ТО «ЮС-ФИЛЬМ»…"
    },
    {
        "id": "name:09923a6e821de8947b0eeb518591e2ec",
        "text": "Эдуард Верхотуров"
    },
    {
        "id": "name:2cb036a4db5b048940a00d796631e2fe",
        "text": "Олег Григорьев"
    },
    {
        "id": "name:c5e8a0e6a82880a39146b54d7d754ae4",
        "text": "«Гонки на выживание - 2»..."
    },
    {
        "id": "name:1b08ba4b7588e289816b682f8ddaae28",
        "text": "Макароны, туника и яйца"
    },
    {
        "id": "name:b7ec9cc75d811888344ee7cab86d3da1",
        "text": "В КАЖДОЙ ШУТКЕ ДОЛЖНА БЫТЬ ГАРМОНИЯ"
    },
    {
        "id": "name:4f608a6bdce3e7d6eb5f4476128262f5",
        "text": "Правдивые истории"
    },
    {
        "id": "name:a23a0c44536510b1bdf296e0a0f0bb09",
        "text": "Игорь Письменный"
    },
    {
        "id": "name:5e3af45258f8580be9036543ff3a7751",
        "text": "Света с Того Света"
    },
    {
        "id": "name:fc97d7bd0d8fa3c708debd3e6c655681",
        "text": "У \"Твоего радио\" - первый детский юбилей!"
    },
    {
        "id": "name:588bb817898d5fdf3b3de733cfa17633",
        "text": "Вновь на экране прапорщик Половинко и его питомцы."
    },
    {
        "id": "name:38903b3923d63092daefffd061736dea",
        "text": "Специальный приз Виктору Андриенко на Винницианском кинофестивале..."
    },
    {
        "id": "name:72d38a7f1c89e9c152cabc44fccc3047",
        "text": "\"Повне МАМАДУ\" знов на екрані..."
    },
    {
        "id": "name:7209696f8d2250931a0e22d83b09f74e",
        "text": "\"Снимается кино...\""
    },
    {
        "id": "name:736361c73f39314949c0d78f2b164efd",
        "text": "Так буде красиво, як вам голими у бані не снилось..."
    },
    {
        "id": "name:ed65af9bb05060221c47723d209174b4",
        "text": "Участие актера Андриенко в ЧУЖОЙ ЖИЗНИ..."
    },
    {
        "id": "name:d5d317eaaa25ab29abed968ec6563711",
        "text": "Чужая жизнь"
    },
    {
        "id": "name:e45d079c5ecb2fef4eae25a5dba03a6d",
        "text": "13 километр"
    },
    {
        "id": "name:b6b2912e9458add0e0b70fcd34a5d6c7",
        "text": "Виктор Андриенко - знаменитый весельчак и юморист..."
    },
    {
        "id": "name:c06c8a0bd61fed7f986c43422c37a74f",
        "text": "Не останні комікі..."
    },
    {
        "id": "name:a196dee077be4ad1fe5031a87a9965fb",
        "text": "\"БЕЗУМНЫЙ НОЯБРЬ\" Виктора Андриенко..."
    },
    {
        "id": "name:a507197e1ad84527b96d7b7d0e455e1b",
        "text": "Безумный ноябрь"
    },
    {
        "id": "name:b3a3149836d716002b9a5768e2dda6c4",
        "text": "Али-баба и сорок розбойников"
    },
    {
        "id": "name:724f5cb22c1398d761f5daadeca39ad8",
        "text": " \"Большая разница\""
    },
    {
        "id": "name:8365d8643ca476368ee0c0ee670b609a",
        "text": "Ситком на Фабрике Звезд..."
    },
    {
        "id": "name:1c45ed9f16a5b287bbf1bf50f0bf037b",
        "text": "С НОВЫМ 2008 ГОДОМ!.."
    },
    {
        "id": "name:1951d4d024ce0cf8c04faab45881fd7e",
        "text": "С НОВЫМ ГОДОМ!"
    },
    {
        "id": "name:efbabcc1b9108bfaa1510f66d8f40c1d",
        "text": "\"13 километр\" в Берлине..."
    },
    {
        "id": "name:bf81bef60d4246393b8391e940a00e3d",
        "text": "Метро"
    },
    {
        "id": "name:0bf56938bc54a70c6124071e41209b0f",
        "text": "Вадим Тупчий"
    },
    {
        "id": "name:db015a1c0c28aef333e6c27295db4875",
        "text": "Новый римейк нашумевшего блокбастера..."
    },
    {
        "id": "name:ef9f3357087b00a364841a5d25b66641",
        "text": "День победителей (укр.)"
    },
    {
        "id": "name:b68f568e19094f1dc95c6c9acf37e080",
        "text": "В Запорожье с 17.03-22.03 открылся юбилейный Х Международный фестиваль “Студенскі жарти - 2008”..."
    },
    {
        "id": "name:92f4dfa569d3935aa3dcb202dbc645b3",
        "text": "\"ОБОЗРЕВАТЕЛЬ\" устроил Андриенко и его команде допрос. С пристрастием..."
    },
    {
        "id": "name:bbf228d6568851b17427fa00d3014037",
        "text": "Каждое утро по будням в «Сніданке з 1+1» - украинское скетч шоу «ВЕСЕЛІ УСМІШКІ»!!!!"
    },
    {
        "id": "name:55d4c4938c515bb0c899e7e4613dcee2",
        "text": "Покорив Россию - «Большая разница» двинулась на Украину"
    },
    {
        "id": "name:198bb428c729eaef03008fc5adf328eb",
        "text": "Доска"
    },
    {
        "id": "name:9cd8e58ea30031bb1cd5ce46b3438ddb",
        "text": "Веселі усмішки"
    },
    {
        "id": "name:be6f0fe6610b065dc6af1e4a20aa6605",
        "text": "Большая разница"
    },
    {
        "id": "name:0a617089d3d844a21a4c2b11b3f1b6cb",
        "text": "Премьера мюзикла \"МЕТРО\"..."
    },
    {
        "id": "name:5bbf890ec3cbf32917beb2060fdc9556",
        "text": "Виктор Андриенко с носом и без..."
    },
    {
        "id": "name:f2688f1023ee4ee10876ee481cdd9d4a",
        "text": "ГЕОРГИЕВСКАЯ ЛЕНТА ЗА «ВЕСЕЛІ УСМІШКИ»"
    },
    {
        "id": "name:ae777e914f631745d0348d61e5cefc0d",
        "text": "Веселі усмішки (Веселые анекдоты)"
    },
    {
        "id": "name:62b6588e17f419be411b0f084c9c8b36",
        "text": "Однажды двадцать лет спустя..."
    },
    {
        "id": "name:a355c741ee342cbbfcf34f631e459510",
        "text": "\"День победителей\" на киностудии им. А.П. Довженко..."
    },
    {
        "id": "name:1ae41d3f85b27d627cc90c6e0a8d8408",
        "text": "ВИКТОР АНДРИЕНКО: СПЛОШНАЯ МИСТИКА"
    },
    {
        "id": "name:a96ca7fdbe37285b6bf0a9a05545c311",
        "text": "Йохан да Мария"
    },
    {
        "id": "name:5f6c1891e9615eb65eb1a985792da21c",
        "text": "\"Большая разница - 2\" на \"Первом канале \"..."
    },
    {
        "id": "name:3b72f90057d450bdde90f22e82fab423",
        "text": "Сергей Сивохо"
    },
    {
        "id": "name:8b1b88bd8f37cbdd327a78e1d868e9d5",
        "text": "Самый шикарный подарок на мой День Рождения..."
    },
    {
        "id": "name:45d15da71d30c0e0c7f3bef4551242a4",
        "text": "Блондинка в накауте"
    },
    {
        "id": "name:6d31c9ae7e2d7938d7ebc291ea1ac836",
        "text": "Большая разница - 2 сезон"
    },
    {
        "id": "name:471ca58af0f6e2328386519048fa052b",
        "text": "Василий Вирастюк"
    },
    {
        "id": "name:e1581b573be2b943cd9c7ef42b4e25e3",
        "text": "\"Блондинка в накауте\" от певца Сереги..."
    },
    {
        "id": "name:83ef0afff346ae011ff436ae4fedf716",
        "text": "\"Большая разница\" - Репортаж со съемочной площадки."
    },
    {
        "id": "name:84afd90ff1b1d352e1b94362055b986a",
        "text": "Независимо от финансовых катаклизмов и отключения русских каналов на Украине..."
    },
    {
        "id": "name:f26719065b8dac02cfbe0010317e0552",
        "text": "Мастера украинского юмора Виктор Андриенко и Валентин Опалев обосновались на НТН"
    },
    {
        "id": "name:283a74985bf4413dda9c384c0792ca91",
        "text": "Режиссер Виталий Малахов сделал артисту Виктору Андриенко предложение..."
    },
    {
        "id": "name:11ea5742e8b531bc037fbd10741459de",
        "text": "1 января 2009г. в 22:30 - передача \"Большая разница\" приглашает всех на новогоднее пародийное шоу..."
    },
    {
        "id": "name:96b495478ebba3e51e0bd0b373aed7db",
        "text": "Виктор Андриенко - неугодный гений"
    },
    {
        "id": "name:497693f0a22853ff70dd3d4fc5a9e6fe",
        "text": "РОЖДЕСТВЕНСКИЕ ПРАЗДНИКИ ВИКТОР АНДРИЕНКО И ВАСИЛИЙ БЕНДАС ПРОВЕДУТ В КАРПАТАХ В ПОИСКАХ БРИЛЛИАНТОВ"
    },
    {
        "id": "name:45d94a1db7ecc504ca006e7123601c03",
        "text": "Большая разница (2008-2013 гг.)"
    },
    {
        "id": "name:0d993f8c10b2c335b93fda4e10fe4e5a",
        "text": "Игорь Кистол"
    },
    {
        "id": "name:308c6b7a6c0a0e011ba9a255664e921a",
        "text": "ВИКТОР АНДРИЕНКО И ИГОРЬ ПИСЬМЕННЫЙ СТАЛИ… КУМОВЬЯМИ"
    },
    {
        "id": "name:aaf87a8e81da10772776d4a1e07220a2",
        "text": "Прикарпатская земля встретила гостей и участников фестиваля двадцатиградусным морозом."
    },
    {
        "id": "name:54e3b7f2ebe752d506b1d349e635e6dd",
        "text": "Сергей Бурунов"
    },
    {
        "id": "name:b5bf10b7e799c19bb8dfbc25e6712a51",
        "text": "Капитан Смолет"
    },
    {
        "id": "name:80cb984c3b905a642e2be7d2408567d4",
        "text": "«О фильмах не надо рассказывать. Их нужно смотреть!»"
    },
    {
        "id": "name:25feb314013f66848ee15825b92eb133",
        "text": "Большая Разница - 3 сезон"
    },
    {
        "id": "name:a170b90e3e0c1b2be1d59520c2c83ce2",
        "text": "Хто боїться дядечку Бабая?"
    },
    {
        "id": "name:ccf91a786e83e36dbb83864279f3738f",
        "text": "Александр Цекало"
    },
    {
        "id": "name:7a4da868bcc473fa123ee61b886a7272",
        "text": "Владимир Кисаров"
    },
    {
        "id": "name:40001322d8bc2c35ad56ca4296cd636c",
        "text": "Теперь «БОЛЬШОЙ РАЗНИЦЫ» станет еще больше..."
    },
    {
        "id": "name:f01c2303d9d7bbe548f8dce21783c156",
        "text": "Борис Барский"
    },
    {
        "id": "name:09ff2174f1939ac4506d39a5d6bd9a05",
        "text": "«БОЛЬШАЯ РАЗНИЦА» ПОЛУЧИЛА ЕЩЕ ОДНУ ПРОПИСКУ"
    },
    {
        "id": "name:911b65e6e4bcd5a2315de7c5ae692d11",
        "text": "Р¤РѕС‚Рѕ"
    },
    {
        "id": "name:6485164dbf6b121f8f192f41808f730a",
        "text": "Как казаки лауреатов выбирали..."
    },
    {
        "id": "name:e5e8d659ddc558a1b24f44a56475dcb7",
        "text": "В «Большой разнице» Гоша Куценко сыграл Илью Муромца"
    },
    {
        "id": "name:bac2016c79d3cd908606a21191ce6b13",
        "text": "С ДНЕМ РОЖДЕНИЯ, ДОЛГОНОСИКИ!"
    },
    {
        "id": "name:6ba335fba43332763b25468fa8d00efb",
        "text": "«СОБЫТИЯ И ЛЮДИ»"
    },
    {
        "id": "name:e12df8d5c80f0d1cc96aed62d7b4d8dd",
        "text": "Рога и копыта"
    },
    {
        "id": "name:f58484a9fe6be26035bbea2481b817d3",
        "text": "\"Большая Разница\" - продолжение следует..."
    },
    {
        "id": "name:6266ffeb770811b04dd4c1653af75122",
        "text": "\"Алые паруса\" - 50 лет спустя"
    },
    {
        "id": "name:2d38cb695102bb4ba14da47675f52f83",
        "text": "Вячеслав Манучаров"
    },
    {
        "id": "name:59506b304b4d117f3bb68ca9ac855628",
        "text": "\"ТЭФИ-2009\""
    },
    {
        "id": "name:f8b5d62682caa083c690e86543b71bd8",
        "text": "Велика Різниця"
    },
    {
        "id": "name:4b8cd817290878af14773b2985c6ee6c",
        "text": "ВИКТОРУ АНДРИЕНКО 50..."
    },
    {
        "id": "name:c635c1816847b973c39ba452ade875d7",
        "text": "Тамара Яценко"
    },
    {
        "id": "name:2cba22f500d5151e7f1930a0f1b5fce5",
        "text": "Наконец-то..."
    },
    {
        "id": "name:5430342f6718ab18b66e6920287750bc",
        "text": "Большая Разница UA"
    },
    {
        "id": "name:f4e016b530c1d74af828dac8ebf9a807",
        "text": "\"Большая Разница\" на DVD!"
    },
    {
        "id": "name:56bb943d86f4dfdb5b8b962711cbcd7a",
        "text": "Не пропустите премьеру!"
    },
    {
        "id": "name:8b178df38ebd44a2a842fa2f6cd2ddd1",
        "text": "МУЛЬТЯШНЫЙ СВЕТЛЯЧОК РЕЙ ЗАГОВОРИЛ ГОЛОСОМ ВИКТОРА АНДРИЕНКО"
    },
    {
        "id": "name:1a5d04d01bd7ad6983bd9edeebec29df",
        "text": "BR \"Программа Интуицыя\""
    },
    {
        "id": "name:b7c1fcedfdba73f916d004412b3414ab",
        "text": "BR Виктор Андриенко"
    },
    {
        "id": "name:97e1e7b59535bf01cc57f842ee1198a2",
        "text": "\"Большая разница\" в Санкт-Пeтeрбурге... "
    },
    {
        "id": "name:d02542cae677855b72e48c6d1d59033c",
        "text": "\"Большая разница\" полетела в космос."
    },
    {
        "id": "name:486302a5c7d9d5360937688c07c4dc70",
        "text": "Большая разница 4 сезон"
    },
    {
        "id": "name:0447e0ad4e4ed7f9f146d207332b2208",
        "text": "Принцесса и лягушка"
    },
    {
        "id": "name:20144acf1b3da8eff7d65013ea0fab36",
        "text": "Рога и Копыта"
    },
    {
        "id": "name:b108fc4816ecdaa06ca42880bf458e67",
        "text": "Мистер Бин на отдыхе"
    },
    {
        "id": "name:47826c579fe96634a346187512f5f1ec",
        "text": "Принцеса та жаба"
    },
    {
        "id": "name:93485b63f3a50f3c9cb0976138c24a16",
        "text": "\"Большая Разница\" - по украински скоро вновь в эфире."
    },
    {
        "id": "name:adb30099566ff125c7e4c8cfdea27854",
        "text": "Светлана Галка"
    },
    {
        "id": "name:40bb87937bbcba41aabe24b0bcfe54e3",
        "text": "\"Принцеса та Жаба\" песня Рея \"Эванжелин\""
    },
    {
        "id": "name:624f25da72491492900bdac52ba5d763",
        "text": "\"Принцеса та Жаба\" песня Рея \"Путь к мамочке Оди\""
    },
    {
        "id": "name:1b57c4cf834df3143707a178304fded4",
        "text": "\"ВОРОНИНЫ\""
    },
    {
        "id": "name:39d1746418bc3cac0c13437d1084b175",
        "text": "\"Велика різниця\" (Большая разница UA)"
    },
    {
        "id": "name:12b4f30eb2d87ce09eb2bf39d21e56d0",
        "text": "\"Ликвидация - Капитуляция\""
    },
    {
        "id": "name:452a4fa496438172678beb59fcc7fb7b",
        "text": " ВИКТОР АНДРИЕНКО: \"АЛЕКСАНДР ЦЕКАЛО ОТБОРОМ АРТИСТОВ НЕ КОМАНДУЕТ. ДАЖЕ ЕГО БРАТ ВИКТОР КАСТИНГ НЕ ПРОШЕЛ\""
    },
    {
        "id": "name:9ee3d2df13aa3947deff3f6174ebaa2c",
        "text": "\"Машина времени\""
    },
    {
        "id": "name:bfd38b0e44290f968ce6e7bc895313f3",
        "text": "Воронины - 3 сезон, 63 серия \"Счастливый костюм\""
    },
    {
        "id": "name:49cd337c9bf65eb74726338e023093b4",
        "text": "Лев Иванович"
    },
    {
        "id": "name:d44d297055fc4f06f1de140a081eb8fd",
        "text": "Риск благородное дело"
    },
    {
        "id": "name:e49d081519b8db641113754581c2b45c",
        "text": "С 10 апреля телеканал ICTV начинает регулярный показ шоу Велика різниця (Большая разница по-украинськи)"
    },
    {
        "id": "name:e43758608ff267b5e445a10edc6e9994",
        "text": "Велика різниця"
    },
    {
        "id": "name:edad410b021e64259ad7d06f07ffd8a6",
        "text": "Велика різниця - 1 сезон 7 выпусков"
    },
    {
        "id": "name:3334520c36b27c1cf0a5acd06fe8c12f",
        "text": "Оливье шоу на \"Первом канале\" России"
    },
    {
        "id": "name:f603cae0d59bc139437d73745b78a4ef",
        "text": "ТЕАТР УМЕР - ДА ЗДРАВСТВУЕТ ТЕАТР!"
    },
    {
        "id": "name:de8b41677c7e3152e1c06517eb80c115",
        "text": "Черта с два"
    },
    {
        "id": "name:6998919abca721b7d9db279634cd8b15",
        "text": "\"Черта с два\""
    },
    {
        "id": "name:ba3a11314fee9809a7890a3102a09def",
        "text": "Телетриумф \"Большой разницы\" в Украине..."
    }
]