[
    {
        "id": "name:03bacc33fc6d49d4f91bd1db942a1cf6",
        "text": "Продолжение следует..."
    },
    {
        "id": "name:4a7781d83917f94d93ddce1d89475f9f",
        "text": "Работать на украинском ТВ в развлекательном формате бессмысленно"
    },
    {
        "id": "name:2264d17cc50ab2978245bd769a6f13a6",
        "text": "Третий год получать ежегодно ТЕФИ - это уже привычное постоянство."
    },
    {
        "id": "name:29b416e39e10c5b177792ac1cf436470",
        "text": "Новогоднее приключение"
    },
    {
        "id": "name:c0d3ac5d2615d5dc93c092c25f851f31",
        "text": "Футобольное скетч-шоу с Александром и Виктором Цекало..."
    },
    {
        "id": "name:89769e9ad1d695e6df4a658ce4fe7535",
        "text": "\"Большая Разница\""
    },
    {
        "id": "name:2c6a6cf5f51498f267f1cc6569ab7ad9",
        "text": "Антон Колесников"
    },
    {
        "id": "name:e08298c1ea9fc854537f80de37ec6fc8",
        "text": "\"Кумские Байки\" "
    },
    {
        "id": "name:f4d178d26f1d8e5d008920212e17150c",
        "text": "Большая Разница, Велика Різниця, Вялiкая рознiца"
    },
    {
        "id": "name:7093c3d935e630011e6deb1afdafbb1b",
        "text": "Виктор Андриенко: «Я двадцать раз шутку не продаю»"
    },
    {
        "id": "name:0de27bc7dcb26020dfeaab7d30da265f",
        "text": "Виктор Андриенко: \"Я - фартовый\"."
    },
    {
        "id": "name:0f9d35e30708fa70adeafef5fca21339",
        "text": "Азиза Ибрагимова"
    },
    {
        "id": "name:4ffefb0a62556888dd12dcef0d1d8802",
        "text": "Вялiкая рознiца (Белорусия)"
    },
    {
        "id": "name:504420ebdb4444dac783a7f8ce030dc5",
        "text": "Кумские Байки"
    },
    {
        "id": "name:54af950745c55081c126a35a10bb9baa",
        "text": "\"Оливье шоу\" на \"Первом канале\" России"
    },
    {
        "id": "name:b85321101955c8d6444c4c1a9e107ba2",
        "text": "С НОВЫМ ГОДОМ!!!  "
    },
    {
        "id": "name:cd3cb6981cd76476490ed219323bf47e",
        "text": "ПРЕМЬЕРА НА ПЕРВОМ НАЦИОНАЛЬНОМ!"
    },
    {
        "id": "name:8b3a0e21d4021d4fc200430131f9eb18",
        "text": "Мнение..."
    },
    {
        "id": "name:7d6fd638ad76925b4b35a295ebb83296",
        "text": "Велика різниця (Новогодний выпуск)"
    },
    {
        "id": "name:2c4cdb98c32d8193801cb8459e483450",
        "text": "Последняя жена синей бороды"
    },
    {
        "id": "name:cc8ae6afa427718f9e71645c31732dc2",
        "text": "Интернет-конференция для Информационное агентства ЛIГАБiзнесIнформ"
    },
    {
        "id": "name:accfeb1ba395a511fdf88f822a2e7fc4",
        "text": "Хотите увидеть новую комедию?"
    },
    {
        "id": "name:2584ca16b92bd61bd420412dca2d3296",
        "text": "”Тот, кто прошел сквозь огонь”"
    },
    {
        "id": "name:a6d34fd52df8072b007b8582df750fe4",
        "text": "ТотКтоПрошелСквозьОгонь"
    },
    {
        "id": "name:4142763bd64b4d2073f010fe47ac35e5",
        "text": "\"Мы не пародисты, мы актеры \"Большой разницы\"..."
    },
    {
        "id": "name:399feb83b6b2698fe2ef527643fcdf5a",
        "text": "Мы не пародисти. Мы актери «Большой Разницыі» "
    },
    {
        "id": "name:1d404e80b583cfe765d7823b2a87ad51",
        "text": "\"Велика різниця\" 2011..."
    },
    {
        "id": "name:3ae1d16da6e39982a6af2fb29393fcc4",
        "text": "Новый сезон съемок в Москве."
    },
    {
        "id": "name:78ef13c73ee06ebf9f16322f10446abb",
        "text": "Большая разница по украински"
    },
    {
        "id": "name:a4991e8b1d93b0a53e758390333cc68b",
        "text": "«Студенческие шутки-2011»"
    },
    {
        "id": "name:2656a07494fb6b821200f8d3b447af5d",
        "text": "Внимание мотор..."
    },
    {
        "id": "name:47853f4f5543426b36e806fdfe35f3c7",
        "text": "С чего смеются украинцы?"
    },
    {
        "id": "name:839af18de825e23b0b0e554a841db2d5",
        "text": "Всеукраинская премьера"
    },
    {
        "id": "name:c5524be6fa5c85a1ad26b19ce117ba80",
        "text": "В прятки со звездой..."
    },
    {
        "id": "name:5b0c974c255ca6dd5a57bf72f944547b",
        "text": "Звездные голубцы"
    },
    {
        "id": "name:5ed1fa151056b7ca4966e9e1356ebb85",
        "text": "\"ЗОЛОТАЯ ПЕКТОРАЛЬ 2011\" в Трусковце..."
    },
    {
        "id": "name:5891ae4009ddb0d097d76780be1164c5",
        "text": "\"КОСТОПРАВ\""
    },
    {
        "id": "name:598011e83d131ed1e7fd9c2d07e429f6",
        "text": "Костоправ"
    },
    {
        "id": "name:7a4bd276dc9bc281305d6e7be8dd607d",
        "text": "Всенародные Семейные Прятки"
    },
    {
        "id": "name:4b2f4eca2aa6cf69d52d43c561ea92ad",
        "text": "«Коронация слова» "
    },
    {
        "id": "name:bcefbb54d52cbee26bd7168fb10e0a14",
        "text": "\"Призвание\""
    },
    {
        "id": "name:4729aec7df7dca678e6a6cce0c8747dd",
        "text": "\"ВИННИЦИАнський\" кинофестиваль"
    },
    {
        "id": "name:8f72b1dcc0e8a37c0cd59662711b9986",
        "text": "«Большая Разница в Одессе»"
    },
    {
        "id": "name:d6209dd063f5552890237937c64977f3",
        "text": "Премьера!"
    },
    {
        "id": "name:7f34e1ac1f4d709fcd55d6f43ddcc2bf",
        "text": "За кулисами \"Большой разницы\""
    },
    {
        "id": "name:fae3fa26b515c67e0d4158a9b9a6dee9",
        "text": "Большая разница (Новый сезон)"
    },
    {
        "id": "name:f1f9432a2d802f03744d00bb0f7490cb",
        "text": "Байки Митяя"
    },
    {
        "id": "name:4ff34b237a74860f5bd0e156879c728f",
        "text": "Ласточкино гнездо"
    },
    {
        "id": "name:49efc188fcd0980ef105fd88dd7d9990",
        "text": "«ПЕРЕЕЗЖАЯ НА ДРУГУЮ КВАРТИРУ, ЗАБИРАЮ С СОБОЙ ВЕДРО И ДВЕРЬ»"
    },
    {
        "id": "name:745a2abc41b0e042c52a2dc8d0549ede",
        "text": "Как казаки у Петривцях гуляли"
    },
    {
        "id": "name:76fa47c6b2f6ef5b7b98aef33644321e",
        "text": "«Звезды против наркотиков»"
    },
    {
        "id": "name:6b83b123681a8010699011352a08ad87",
        "text": "«Молодожены» на СТС"
    },
    {
        "id": "name:0ff35a64351de261cad4c13854980f79",
        "text": "Очередной \"ТЕЛЕТРІУМФ\" Большой Разницы"
    },
    {
        "id": "name:2b2d2a9d96259b6fe3a421cc1e8c3ec8",
        "text": "Виктор Андриенко отдал свой голос Хрюндикову..."
    },
    {
        "id": "name:b6d643e7590fdfdc3eb61fd568be8823",
        "text": "Молодожены 1 сезон"
    },
    {
        "id": "name:825ef3f7297ed68f6c8b30b42cc98607",
        "text": "Тайна Диона"
    },
    {
        "id": "name:7b4541c8e66b15c785f621e6acdaf5b0",
        "text": "В Новый год с ОЛИВЬЕ!"
    },
    {
        "id": "name:e986399a628ca046d097c066f159c10f",
        "text": "В Новый год зрители узнают \"Кто кому кто\""
    },
    {
        "id": "name:13f4b449d2981170dbf5e45b1578b639",
        "text": "С Новым Годом!"
    },
    {
        "id": "name:71d7c5e8cc2d4513d4184f0e6252725c",
        "text": "Премьера в Полтаве"
    },
    {
        "id": "name:5484da5e86ab7933f7e74bb2648a6aee",
        "text": "Украинцы готовы поддержать национальный кинопродукт"
    },
    {
        "id": "name:fd10e68fb3b5eb331a155de388ac9da3",
        "text": "Воронины"
    },
    {
        "id": "name:209fd9295816385b3496a3e982dd615d",
        "text": "Молодожены"
    },
    {
        "id": "name:db7048d37de7324129fb10769b929e0d",
        "text": " \"Байки Митяя\" - премьера в двух странах"
    },
    {
        "id": "name:c77a145f3c27e06fbf6bb1cb821179a3",
        "text": "\"Прошедший огонь\" в Одессе, Львове, Донецке, Житомире... "
    },
    {
        "id": "name:2868a0361044041c28046580e9fd99be",
        "text": " «Байки Митяя» - лидер ТВ Украины."
    },
    {
        "id": "name:0fbc73422fd21a209e34e90865783bb3",
        "text": "«ТойХтоПройшовКрiзьВогонь» покоряет сердца"
    },
    {
        "id": "name:be29a6a6579bf64ca38617040ecb5344",
        "text": "«ТойХтоПройшовКрізьВогонь» - премьера в Запорожье"
    },
    {
        "id": "name:500dc41d0fc29bb28f7787dd5265d47b",
        "text": "«Прошедший огонь»: слезы и шквал аплодисментов"
    },
    {
        "id": "name:87d2decca569788adf503359e92ffe52",
        "text": "\"Студентські жарти-2012\""
    },
    {
        "id": "name:c69c410774148cd91f7f49bc85dbe617",
        "text": "Вопросы - Ответы"
    },
    {
        "id": "name:091fc9d7d2b91eeb28f95a757d8a5417",
        "text": "Виктор – озвучил очередного своего пирата."
    },
    {
        "id": "name:f8152b7815b0292f03e092235a4bcbe2",
        "text": "Украинское кино в Каннах"
    },
    {
        "id": "name:010b5e3c448869d5c1d9a895d5a0d642",
        "text": "ДЕНЬ РОЖДЕНИЕ ДОЛГОНОСИКОВ"
    },
    {
        "id": "name:21c55c98c41b5bc724fd50fae4b0fd19",
        "text": "Большая Разница по украински 4 сезон"
    },
    {
        "id": "name:cab82d244791c58c55044580c11b7db7",
        "text": "\"Золотая Бригантина\" "
    },
    {
        "id": "name:39abe76f68e40b02465aaa73b925f506",
        "text": "«Золотая Бригантина» Виктора Андриенко"
    },
    {
        "id": "name:f534f2e9613fdc2c9450a9569154c493",
        "text": "\"Ивана Силу\" короновали! "
    },
    {
        "id": "name:e027431901700490962376c4ad0b8ff8",
        "text": "Награды нашли героев"
    },
    {
        "id": "name:beeb6110351ac191eba573f0eda0acfa",
        "text": "Виктор Андриенко: о фильме \"Иван Сила\", о красивых женщинах и многом другом "
    },
    {
        "id": "name:e8de94b5f0e6059a3ec43726ca5238d5",
        "text": "Віктор Андрієнко: я за літературну українську мову, без \"пАльт\" і \"дрібноживцевзнвцев\""
    },
    {
        "id": "name:bef246ca8273cee898c178fc832d8210",
        "text": "Молодожены 2 сезон"
    },
    {
        "id": "name:0f10ebe85f6d6bf5d94db46260ac52f7",
        "text": "ТРЕТИЙ ОДЕССКИЙ..."
    },
    {
        "id": "name:29ac15c7c614becda4ae4014ab1c9ccc",
        "text": "Михаилу Ильенко - 65!"
    },
    {
        "id": "name:e21e26c1a241f8468ea5350035f4c3cc",
        "text": "Кмские Байки"
    },
    {
        "id": "name:81be8b3c0ab41ba14baa69cda900bcd2",
        "text": "Рекорд на Одесском кинофестивале"
    },
    {
        "id": "name:d1f78a9997708cc4f3c6b974094ff02b",
        "text": "Пірати. Банда невдах"
    },
    {
        "id": "name:2f1a1b93f19f8e163918e6f993a6b18c",
        "text": "По ком звонит колокол..."
    },
    {
        "id": "name:d5c5d2cc3faf2028f41b2a6ad5e79a76",
        "text": "Пірати Банда Невдах"
    },
    {
        "id": "name:711bd4e8cd3a8cfc1f5fb90423f1cf59",
        "text": "Большая разница в Одессе 2012"
    },
    {
        "id": "name:3cbf659c2d1493aa59571303deaf397b",
        "text": "Стартовал новый кинопроект «Иван Сила» "
    },
    {
        "id": "name:237c2397ae0f3611fd4d073ebda0b769",
        "text": "\"Иван Сила\" в Черновцах "
    },
    {
        "id": "name:872ce5a2b1185cf7c964318fd055cc20",
        "text": "Съемки фильма \"Иван Сила\" - в разгаре "
    },
    {
        "id": "name:e3913030807e4bb2de81cf1a455737cd",
        "text": "Новый год жизни"
    },
    {
        "id": "name:8a48323e80062c01a344a1c4a52ea4b4",
        "text": "«Дни Украинского кино» в Тернополе"
    },
    {
        "id": "name:9bb6ac63470696fc3a9ac047f64af75e",
        "text": "На родине Ивана Силы - КРОТОНА"
    },
    {
        "id": "name:6c8077a560e00ee4ed176eb13e63dce7",
        "text": "Продолжение следует.."
    },
    {
        "id": "name:79e326532cb44c1307e83f977f6572af",
        "text": "42-й Международный кинофестиваль «Молодость»"
    },
    {
        "id": "name:8fca6c9b97660e1f0c070a965db3c747",
        "text": "С 25 по 30 октября съемочная группа продолжает работу над фильмом в Закарпатье "
    },
    {
        "id": "name:d4ad486f3b9104cae7a3bdd9b7d3b7bb",
        "text": "Живая сила"
    },
    {
        "id": "name:0b9dbd976b180455be496ba5a108924a",
        "text": "Новый этап - «Большая разница»!"
    },
    {
        "id": "name:e995be0ad6bc4b4e65a5b46cec6e8e19",
        "text": "СТОП -СНЯТО!!!"
    },
    {
        "id": "name:76b1bfb63c43e91fcd598e908eef4736",
        "text": "Большая разница по украински - сезон 5"
    },
    {
        "id": "name:ec906db383b8e7c848c4e424348e713d",
        "text": "Иван Сила"
    },
    {
        "id": "name:4fc6e3b617f2dc895e020e692562cd90",
        "text": "Развод"
    },
    {
        "id": "name:8dbedfcbc00045940258858ea65b2448",
        "text": "Большая разница ТВ (Россия) новый сезон"
    },
    {
        "id": "name:d035deb9465e802e8e6ba735d0d88762",
        "text": "Виктор Андриенко — про украинского богатыря и национальной киностудии"
    },
    {
        "id": "name:540eb67a76185eb2d70fc1fe2fec86c4",
        "text": "О богатырях Украины и Национальной киностудии..."
    },
    {
        "id": "name:2f322ed0430eb6012367fda81b1559ed",
        "text": "ЮБИЛЕЙНАЯ ПРЕМЬЕРА"
    },
    {
        "id": "name:3c2c054bf49fb87f3bd07b20dbce6f29",
        "text": "Ушел из жизни Валерий Бесараб"
    },
    {
        "id": "name:3daaa5962953ea0ad3b6f8ec5cbc2a5e",
        "text": "Украинские силачи в Берлине."
    },
    {
        "id": "name:fb85084668045bd5262a687ac86a33d6",
        "text": " \"Иван Сила\" - для европейского зрителя"
    },
    {
        "id": "name:cea7f44f4d1b66485288a88b7783ecc4",
        "text": "\"Иван Сила\" набирает силу"
    },
    {
        "id": "name:974db75630e8762df17fbe167f32606f",
        "text": "Красота спасет!  "
    },
    {
        "id": "name:4265d74825b1c4f695cf561c4b16da27",
        "text": "\"Студенческим шуткам\" - 15 лет"
    },
    {
        "id": "name:2b4ee888e33ec458e6d1781a78ec25bb",
        "text": "Виктор Андриенко – считатает 1 апреля профессиональным праздником."
    },
    {
        "id": "name:60a79a9510db46bcbed6dfa75ee0cf7a",
        "text": "Soundtrack к \"Ивану Силе\"."
    },
    {
        "id": "name:f045ca966699abdd2139ed4a15babbcb",
        "text": "Украинским звездам придется очень много читать"
    },
    {
        "id": "name:3f46734acb32caddf99165dbb5d0ae75",
        "text": "Вампировы"
    },
    {
        "id": "name:44106c8812995791875e3a2e3a1ae7b5",
        "text": "Алиса знает, что делает"
    },
    {
        "id": "name:c7f428ab5fa26b0323bb03a37c87e261",
        "text": "Фотосессия \"Ивана Силы\""
    },
    {
        "id": "name:a10c16f965ec554037596f522265100d",
        "text": "Иван Сила - заговорил."
    },
    {
        "id": "name:b890e216e2758517a5b36ed65460920f",
        "text": "Читка пьесы..."
    },
    {
        "id": "name:8d12a882269ce20a1904aef67abaeeb9",
        "text": "XVI Международный Кинофестиваль «Бригантина»."
    },
    {
        "id": "name:1fa04ba87edb05480f6248f671a66447",
        "text": "Первые профессии Звезд."
    },
    {
        "id": "name:55d440257e971c2c432ecc39840f0d2f",
        "text": "\"Иван Сила \" в гостях у \"Коронации слова\""
    },
    {
        "id": "name:a2318776857da438ba7895dde84cf324",
        "text": "НА ОМКФ ПРЕДСТАВЯТ 19 НОВЫХ УКРАИНСКИХ ФИЛЬМОВ."
    },
    {
        "id": "name:f004b9c1fd4cb8447e6340f82b2239ab",
        "text": "Зачем государству тратить деньги на кино?.."
    },
    {
        "id": "name:a82f315283460a1b6da1d99980c58ce8",
        "text": "Виктор Андриенко привез в Одессу самых сильных людей мира.."
    },
    {
        "id": "name:6d2ffd079b28dc94811690368580cc0a",
        "text": " Виктор Андриенко о своем фильме \"Иван Сила\" и украинском кино. "
    },
    {
        "id": "name:cc388cfbbffc8f8a3c25023ab7b3779b",
        "text": "Новые \"КИНОГЕРОИ\""
    },
    {
        "id": "name:f71b3880ee00937761e4362f3a061792",
        "text": "ОСТРОВУ СОКРОВИЩ 25!"
    },
    {
        "id": "name:f2b1555dcd09c15c6625e4f394fce1ee",
        "text": "«Иван Сила»: год первый."
    },
    {
        "id": "name:e5ec0e27ef5532d8cf76b1a1162e260e",
        "text": "\"Иван Сила\" в Запорожье."
    },
    {
        "id": "name:63b8d3bc2a41e1eaba0f4fce1abbe822",
        "text": "Начались съемки киноверсии  «Тевье-молочника» "
    },
    {
        "id": "name:8b15ebc550e5ca545bffc671a14d30d5",
        "text": "Виктор Андриенко отгулял день рождения с богатырями"
    },
    {
        "id": "name:71fe6c4af2eb360092909b63b7990d5d",
        "text": "ЯК ДВІ КРАПЛІ"
    },
    {
        "id": "name:fbf5ec687f77b0f887d799aad2a753da",
        "text": "Cайт фильма «Іван Сила»"
    },
    {
        "id": "name:cc415e7da76eff85b241f9f382a38dc5",
        "text": "IX ЕРЕВАНСЬКИЙ КИНОФЕСТИВАЛЬ"
    },
    {
        "id": "name:b2e5c06a032fe12819e04f2f6e04f6a6",
        "text": "НОВЫЙ ЧЛЕН ЖЮРИ"
    },
    {
        "id": "name:786896fd8ad6e04153874ae813875d41",
        "text": "\"1+ Один Дома\""
    },
    {
        "id": "name:0fe906e6c6c088188fa15b81bc4d3cb3",
        "text": "Финал Открытой киевской лиги КВН \"ОтКЛиК\"..."
    },
    {
        "id": "name:51357a2f96c2411bd6a70d685e73330b",
        "text": "Кино на равных..."
    },
    {
        "id": "name:aba982967a2b390074723bcab9343db1",
        "text": "Сон афганской войны"
    },
    {
        "id": "name:9bd6067f0ec099cd8f3af596c1ddeb1b",
        "text": "Иван Сила в Доме Кино."
    },
    {
        "id": "name:61c2f728fa8a7d31bb0d2c1e57b3e3d8",
        "text": "\"ИВАН СИЛА\" В ДОМЕ КИНО"
    },
    {
        "id": "name:089e16de39f9f3ac65e09e36ed459812",
        "text": "Фильм \"Иван Сила\" подан на Государственную премию."
    },
    {
        "id": "name:fc455a3ef6f3461071e9378ca4333626",
        "text": "Премьера 2014 года."
    },
    {
        "id": "name:68c96ca5b930d530cbab6e2bb2701183",
        "text": "Еще одна победа \"Ивана Сили\"."
    },
    {
        "id": "name:253060c603e0f7dd93fb168ae6964c19",
        "text": "1+1 Дома. Новый Год."
    },
    {
        "id": "name:d53e59ac7d090c57604b390c95d37a13",
        "text": "С ДНЕМ РОЖДЕНИЯ!"
    },
    {
        "id": "name:f95550a064ad19e279a6ce48c01787bf",
        "text": "Алиса знает, что делать!"
    },
    {
        "id": "name:567b6dfa32569f8302e1e0159f219c51",
        "text": "День Рожденье раз в... четыре года!.."
    },
    {
        "id": "name:cbe602649fc9dec7c19f44a63cc599f9",
        "text": "Актеры Большой Разницы в новом проекте."
    },
    {
        "id": "name:efe7b2fe72ffe8597c485d43202796f0",
        "text": "Супер Герои"
    },
    {
        "id": "name:e0ba1d819d1427073040729fa7f83d2a",
        "text": "Большая разница по украински - сезон 6"
    },
    {
        "id": "name:2155e78f9a10c82c378097ee6a889835",
        "text": "СЕДМИЦА УКРАИНСКОГО КИНО"
    },
    {
        "id": "name:e47bf99b06cc852842ba0ca5fc4a208f",
        "text": "ПОСЛЕДНИЙ ПОЕЗД 2016 г."
    },
    {
        "id": "name:04c5c3e730130edbf7c4b80002ae5ad2",
        "text": "ЧАТ С ВИКТОРОМ АНДРИЕНКО"
    },
    {
        "id": "name:afc77848afc382d7e0436d92a77c3c6c",
        "text": "БЕНЕФИС ОЛЕГА ФИЛИМОНОВА"
    },
    {
        "id": "name:a6f5697878aece7265a8bf86e64c3e26",
        "text": "Алиса знает что делает."
    },
    {
        "id": "name:76829a50e18479f3b2e005ab34cec3e9",
        "text": "Кто боїться дядечку БАБАЯ?"
    },
    {
        "id": "name:fb4877015f50d848eae9b30aa4ea4594",
        "text": "Літа мої"
    },
    {
        "id": "name:4d05c1720c4f7d1c77266749a9255b5e",
        "text": "З ДНЕМ УКРАЇНСЬКОГО КІНО!"
    },
    {
        "id": "name:b9e6903054dd1e47eadabad7387cc832",
        "text": "\"ИВАН СИЛА\" В МОСКВЕ!.."
    },
    {
        "id": "name:54cbbb7e4ed91cf26064d4d125e6bff2",
        "text": "\"ИВАН СИЛА\" на ТВ."
    },
    {
        "id": "name:0018ff1e96ad2162d22cd11f66821793",
        "text": "НОВАЯ РОЛЬ..."
    },
    {
        "id": "name:f6ec57391fb78be4a69068c0c1efa727",
        "text": "11 июля в Одессе открылся V Одесский международный кинофестиваль."
    },
    {
        "id": "name:32d7e7cd1cbccd6ed0dac8a7461a505a",
        "text": "\"ФОРМУЛА ПАРКАНА\""
    },
    {
        "id": "name:6503636d2fd0f019d59725db967d152c",
        "text": "Новогоднее шоу в сентябре."
    },
    {
        "id": "name:9bc21832b20bcd5c4c0972e2d44bf12e",
        "text": "О ПРОШЛОМ И БУДЕЩЕМ."
    },
    {
        "id": "name:2263157d286c56d0e4fe522348718ffa",
        "text": "\"Славянская сказка\" в Болгарии"
    },
    {
        "id": "name:23a90e9d358bdd54ad18b2fa856ad880",
        "text": "ПОЕЗД «ОДЕССА-МАМА»."
    },
    {
        "id": "name:4c49cb6670383a29ff5900ec9a77d899",
        "text": "НА ОДНОЙ СЦЕНЕ С ЧЕЛОВЕКОМ ЭПОХИ"
    },
    {
        "id": "name:aec82811f843d8ab1145e7fbcde2bef3",
        "text": "ПРЕМЬЕРА НА ТВ."
    },
    {
        "id": "name:a2aae8e6d77795b54220b9b9bfb694af",
        "text": "\"КОРОНА КАРПАТ\" -2014"
    },
    {
        "id": "name:cbb4d081c0051c2768fd1264f9fdf6c2",
        "text": "НАЕДИНЕ СО ВСЕМИ"
    },
    {
        "id": "name:a5f2c26bab1fa04593604c69b581a3a9",
        "text": "В добрый и долгий путь!"
    },
    {
        "id": "name:da7beb80dc5e5c7b8eab4735ffb0349b",
        "text": "Светлая сторона силы..."
    },
    {
        "id": "name:7fe7b97b172c8bd8c4803d96ac00541d",
        "text": "\"Российское запрещаем, а свое не субсидируем.\""
    },
    {
        "id": "name:85a72d3deda6abaf33a870b2abec0c4e",
        "text": "Одесса-Мама проездом в Харькове ..."
    },
    {
        "id": "name:a523e8ccfa71b1b9f15d8990f1438ff7",
        "text": "Работаем на будущее, создаем свое будущее!"
    },
    {
        "id": "name:34faa142062f32502d772750ccce815d",
        "text": "БУЧАНЦЫ ПОЗНАКОМИЛИСЬ C \"ИВАНОМ СИЛОЙ\""
    },
    {
        "id": "name:7835e0f502de6e12367cc0b8cc416e3d",
        "text": "КАТИТСЯ, КАТИТСЯ ОДЕССКИЙ ВАГОН!"
    },
    {
        "id": "name:50c8faeef416e733bd5dd1510cf9c591",
        "text": "Чат-конференция: новые проекты "
    },
    {
        "id": "name:f6a2741e5c4ec2dfc5514629d1ae33f3",
        "text": "«Простіше знайти кошти у приватних інвесторів, ніж стояти на колінах перед Держкіно»"
    },
    {
        "id": "name:71041a693c6e09d8e6365c156ec3764a",
        "text": "Продолжение следует."
    },
    {
        "id": "name:2b711d3909ccd98f31b75803ee2a98e5",
        "text": "Украинскому кино нужны новые герои"
    },
    {
        "id": "name:f371baa96447d13bb0497639ef1c4cc3",
        "text": "«Кино: свое для своих». "
    },
    {
        "id": "name:f95af6d143cbc9232b4ee9a739d63c5d",
        "text": "В Украине нужно снимать новые фильмы с собственными героями, — Виктор Андриенко"
    },
    {
        "id": "name:8309a05ce32f63d3770721717e089115",
        "text": "МНЕНИЕ"
    },
    {
        "id": "name:b4d07803d800b0d271b87aede2720bea",
        "text": "Днепропетровск ожидает прибытия поезда «Одесса-Мама»"
    },
    {
        "id": "name:add7a9c2b46afe64c00df34b9e8c0073",
        "text": "ВСТРЕЧА СО ЗРИТЕЛЕМ"
    },
    {
        "id": "name:3f456e5d06088dd8becbfc2039ba2a31",
        "text": "ДАЕШЬ ДЕТСКОЕ КИНО!"
    },
    {
        "id": "name:9b64902d627b21c239a74f0b00d6a4a8",
        "text": "Украина в Каннах"
    },
    {
        "id": "name:54a826c25ec211bcde3a9414a5342c7e",
        "text": "НАРОДНЫЙ ПОВАР"
    },
    {
        "id": "name:64caa959d21c9236092c9bf901691a36",
        "text": "Открытие Одесского кинофестиваля 2015 г."
    },
    {
        "id": "name:0bb345914ec9384bb047f0e8502d0bdc",
        "text": "АРТ-ПИКНИК с Виктором Андриенко"
    },
    {
        "id": "name:647a49da0710ddc5f37892cc5b67af2b",
        "text": "Бердянский детский кинофорум \"Золотой ключик\" "
    },
    {
        "id": "name:eb3191de36eed5ca782469194fa07702",
        "text": "Держи удар"
    },
    {
        "id": "name:a0640149acc8af474d8cce24cd33534d",
        "text": "Народный повар"
    },
    {
        "id": "name:931f7cd304e30226f952e836b16b96bd",
        "text": "ПИТЧИНГ на ОКФ 2015."
    },
    {
        "id": "name:a0064fee7414859f84b53b494a9e1682",
        "text": "КАМЕНЬ СИЛЫ"
    },
    {
        "id": "name:ebc3f95ac5806fb777d8e09efd444213",
        "text": "IX Винницианский кинофестиваль"
    },
    {
        "id": "name:fd556e44581f2af265123f392f9b0e95",
        "text": "\"Иван Сила\" на \"Счастливых ладонях\""
    },
    {
        "id": "name:bc4b61918945c9f934d3d5cbf3a24d34",
        "text": "Теорія Паркану"
    },
    {
        "id": "name:f0fcc6f5e4fdb1bf38fa0fa6e3ab1bb7",
        "text": "OLX (реклама)"
    },
    {
        "id": "name:ea209c0cd856168848cc68914b1ca3bb",
        "text": "SLANDO (реклама)"
    },
    {
        "id": "name:ea8e6dd7028b76f999c13767935f475c",
        "text": "ПОЗДРАВЛЯЕМ"
    },
    {
        "id": "name:fc8093557306bee59be2a5499cf0a236",
        "text": "КИНО ДЛЯ ГЛУХИХ"
    },
    {
        "id": "name:44a70b070cd39b20634295764d56d1e0",
        "text": "\"ПОЕЗД \"ОДЕССА-МАМА\"\" В КИЕВЕ."
    },
    {
        "id": "name:61afeeee452ae78b4b89f5175bc997b0",
        "text": "Кинотеатр \"Жовтень\": возрождение из пепла."
    },
    {
        "id": "name:5dabcb3204f25e147265f5c7fee3f389",
        "text": "\"Иван Сила\" на Закарпатте."
    },
    {
        "id": "name:29f391e25810f09a569b1395dbd10afd",
        "text": "ПОЕЗД \"ОДЕССА-МАМА\" НА ТЕАТРАЛЬНІХ ПЕРОНАХ"
    },
    {
        "id": "name:d63825826a48ed55ecc50a8dadadd361",
        "text": "\"ОКНО ЖИЗНИ\""
    },
    {
        "id": "name:196cf6e3c61ab44b7734b200d6269f61",
        "text": "\"ОтКЛиК\" - 2015"
    },
    {
        "id": "name:8afb657b1eb6eb500870fd8e0cb19dd5",
        "text": "«Поезд «Одесса-Мама»»"
    },
    {
        "id": "name:a272fb4084fb5e54e005e64428cb0160",
        "text": "Народный Повар"
    },
    {
        "id": "name:f1831d5a59270cbc10b98181f5ad7355",
        "text": "Как любить по-украински?"
    },
    {
        "id": "name:4a3360e0ed667c456d6b3bf205125fc8",
        "text": "1+1 дома"
    },
    {
        "id": "name:5a136c794e0e47f74675188ce2bb6d51",
        "text": "1+1 дома 2"
    },
    {
        "id": "name:48cc427148acc367bea22be4f58e3871",
        "text": "Никита Кожемяка"
    },
    {
        "id": "name:df8ea77b7f285706c76bed61664a9437",
        "text": "Украинский новогодний огоньк"
    },
    {
        "id": "name:88144f63ffb99dc6f4a5d76f30975422",
        "text": "Ночь святого Валентин"
    },
    {
        "id": "name:cf0bba1d5dc86a13ffd8bb3699b002ab",
        "text": "Подкидыши (Окно Жизни)"
    },
    {
        "id": "name:75db6211647cb890d43948c84c0b57a3",
        "text": "Окно Жизни"
    },
    {
        "id": "name:a24cd02c3c31e73f025057b1d45b8aa3",
        "text": "1+1 дома: 8 марта"
    },
    {
        "id": "name:bd37b0089364d6330e7e1832748a8821",
        "text": "Одесский - NEXT"
    },
    {
        "id": "name:dcc392fd806f826c4bf689f794a4fd9f",
        "text": "НИКИТА КОЖЕМЯКА"
    },
    {
        "id": "name:f27a6e9584e7c30fc84e4cf71aad5bd1",
        "text": "ПРЕМЬЕРА"
    },
    {
        "id": "name:d6eceb9d40a406ec31242f619b47506b",
        "text": "КИНОПРЕМЬЕРА "
    },
    {
        "id": "name:33641c5d5b45cb593daa441ebd11c8de",
        "text": "\"ПОЕЗД \"ОДЕССА-МАМА\"\" 2016."
    },
    {
        "id": "name:9a8cc80c809cf65718279ddd2edb6cfa",
        "text": "ПОЕЗД ВЕРНУЛСЯ В ОДЕССУ"
    },
    {
        "id": "name:ad384c3ffe29d55573f1992a0df3d9e7",
        "text": "КИНО В УКРАИНЕ"
    },
    {
        "id": "name:97a8804ef6e7b5db76d556688abe4d6b",
        "text": "\"СУББОТНЯЯ ЛАПША\""
    },
    {
        "id": "name:8e1d71acd07c5c35d4b7b740d0992762",
        "text": "Поезд «Одесса-Мама»"
    },
    {
        "id": "name:be54895bced86f9acf5ddbf8cb4eb902",
        "text": "«Похождения бравого солдата Швейцмана»"
    },
    {
        "id": "name:d67a7ec3b8540fb60898fc0533525079",
        "text": "NEXT 2016 - эпизод второй."
    },
    {
        "id": "name:bdff16b3afdde59bb470a1a632600b5c",
        "text": "ПОЕЗД С БРАВЫМ СОЛДАТОМ ШВЕЙЦМАНОМ..."
    },
    {
        "id": "name:199cb7ace238f4d6d15763743d039f0f",
        "text": "ПОДАРОК ДЕТЯМ"
    },
    {
        "id": "name:79eb5c63dfd25f4920b32e2435caf80d",
        "text": "УКРАИНСКИЙ АНИМАФИЛЬМ ПОКАЖУТ В БОЛЕЕ 20 СТРАНАХ"
    },
    {
        "id": "name:d05076aa158227a578cfc958d420ba25",
        "text": "Микито Кожом'яко\/Никита Кожемяка\/The Dragon Spell"
    },
    {
        "id": "name:7dfa0b5352cdd84052f0a240bd540937",
        "text": "\"МИКИТА КОЖУ'ЯКА\" НА ОДЕССКОМ КИНОРЫНКЕ"
    },
    {
        "id": "name:07284e59d193e239c4a941b55416e618",
        "text": "Первый “ФИЛЬМ-ФЕСТ-БУК”"
    },
    {
        "id": "name:670ef3fdc9a1328047ad914b4b055193",
        "text": "На конкурсе Мюллеров в Лос Анжелесе, я занял бы 1 место."
    },
    {
        "id": "name:2b0b73e6e0960d3aa7b63676bf17ebee",
        "text": "Панацея для украинского кино? Перестаньте воровать!"
    },
    {
        "id": "name:0398d80b7260f079934b322f1ee7682f",
        "text": "С ДНЁМ РОЖДЕНЬЯ - \"ОСТРОВ СОКРОВИЩ\"!"
    },
    {
        "id": "name:8bc1a8f966c9468ee7ba8876d2784681",
        "text": "ВИННИЦиЯНСКИЙ КИНОФЕСТИВАЛЬ "
    },
    {
        "id": "name:76c6cbe2ebd6514d234fa59fa6176e0e",
        "text": "Мир вашему дому (Тевье, Тевье...)"
    },
    {
        "id": "name:30a46b4bea00d5109389b93ff7299e81",
        "text": "ПОЗРАВЛЯЕМ!"
    },
    {
        "id": "name:8a26dc7dc63bb5038b99f2057be55416",
        "text": "ТЕАТРАЛЬНОЕ СОБЫТИЕ ГОДА"
    },
    {
        "id": "name:3decd61c32e14659c63461986931a969",
        "text": "«Микита Кожум’яка» обогнал по сборам в прокате «Семейку монстров» и «Самолетики-2»."
    },
    {
        "id": "name:61da425d5581301d860061e68f31c45b",
        "text": "Виктор Андриенко: \"Сценарий \"Никиты Кожемяки\" переписывали целый год, было 40 его вариантов\""
    },
    {
        "id": "name:22d458855328a4cd1ff4ecdef8f7c270",
        "text": "\"МОЛОДІСТЬ\" - 46"
    },
    {
        "id": "name:e0d3c04a3660f8ec516a80973e2e3af2",
        "text": "ТЕАТРАЛЬНАЯ ОСЕНЬ"
    },
    {
        "id": "name:9be397f0972605bb7915035c427cafef",
        "text": " \"КРОК\" - ХХII"
    },
    {
        "id": "name:a130845dfe1c1839c23cda5d2ed2063b",
        "text": "КИНОПУТЕШЕСТВИЕ НИКИТЫ"
    },
    {
        "id": "name:3f328ff914c9de3a503c781decfc756f",
        "text": "Кексы Давида Черкасского"
    },
    {
        "id": "name:1b9cddfdb7e786f666a7d6efc1b0bd0b",
        "text": "III NEXT В ОДЕССЕ"
    },
    {
        "id": "name:364b6325e0cf5993525b3244abdd64d4",
        "text": "\"КОМИК НА МИЛЛИОН\""
    },
    {
        "id": "name:c2fd9f4eeddd187b9397b9bf9a6804f1",
        "text": "\"НИКИТА КОЖЕМЯКА\" ШАГАЕТ ПО МИРУ"
    },
    {
        "id": "name:f00a987df81d3e00bc79e103694fe4cf",
        "text": "Як дві краплі"
    },
    {
        "id": "name:29f5661515211d19999ac52eb826f0c8",
        "text": "Окупация"
    },
    {
        "id": "name:d38b0190430f911f226219f9474b08b4",
        "text": "Комик на миллион"
    },
    {
        "id": "name:6e42d35e7f7d39c0ca559e3db96adc48",
        "text": "О СЛАДКИХ И НАУЧНЫХ СНАХ..."
    },
    {
        "id": "name:956d2ed63cc61a64826cff63f1efdde0",
        "text": "О сладких и научных снах..."
    },
    {
        "id": "name:56f1220c3f27d70a5937260467a6693d",
        "text": "ПОЕЗД ТРОНУЛСЯ"
    },
    {
        "id": "name:08a816c19e8671a9878b45adca4d10d3",
        "text": "ОДЕССКИЙ ПОДКИДЫШ В КИЕВЕ"
    },
    {
        "id": "name:14cc1ad91d3706ba905a4402bbe5deaf",
        "text": "25 ЛЕТ СПУСТЯ"
    },
    {
        "id": "name:009ba79f252f96b50d83c66f280704e8",
        "text": "\"ЗОЛОТАЯ ДЗЫГА\""
    },
    {
        "id": "name:6360e2f3c91ae9206c17260af5e20a88",
        "text": "РІЧНИЦЯ"
    },
    {
        "id": "name:7f866dfe06c0cee20ed6eb2cd0dbc60c",
        "text": "ОТ ИВАНА ДО МОЛЬФАРА"
    },
    {
        "id": "name:4191f8862aa4bf0ac607e213975d6898",
        "text": "VIII ОМКФ 2017"
    },
    {
        "id": "name:25217ff97eafaf93b6fe1f3c77e5eda6",
        "text": "Главный \"долгоносик\" Украины о жизни и илюзиях."
    },
    {
        "id": "name:c698f139816305e2b64e06332670765b",
        "text": "ДЕНЬ КИНО  В ОДЕССЕ"
    },
    {
        "id": "name:1246e1042c70a26ac8234a90589ac14c",
        "text": "КОМИК НА МИЛЛИОН"
    },
    {
        "id": "name:2c42b91432feb828b523a48cf989ff65",
        "text": "\"МУЖЧИНА ПЕРЕД ЗЕРКАЛОМ\""
    },
    {
        "id": "name:0ff41f8f1d1308ff86ff83375a93487c",
        "text": "ТЕРНОПОЛЬ НАКРЫЛА «КИНОВОЛНА»"
    },
    {
        "id": "name:1c8c4214bf50147a46d32ddafce6d5b0",
        "text": "ПО ЖИЗНИ С УЛЫБКОЙ."
    },
    {
        "id": "name:dbcda7be87e3fc08a7af6c1ed8f2ef0c",
        "text": "ПО ЖИЗНИ С УЛЫБКОЙ..."
    },
    {
        "id": "name:55d0842257ec680d704753be36b0d3fb",
        "text": "БОЛЬШАЯ СХОДКА"
    },
    {
        "id": "name:aa902a9806c11b2cb9f81ed8c31d6ff4",
        "text": "Мир Вашему Дома"
    },
    {
        "id": "name:812973269eaa9d205b7112a541441bd7",
        "text": "С МЕЖДУНАРОДНЫМ ДНЁМ КИНО "
    },
    {
        "id": "name:b2dcfb0cab30b605b41c6e9c39a0f960",
        "text": " НОВЫМ 2018 ГОДОМ!"
    },
    {
        "id": "name:d7c05e0edc1671230291893b5b6490a9",
        "text": "ДІАМАНТ КАРПАТ"
    },
    {
        "id": "name:3fa4f1779224416128151f29ee65cb04",
        "text": "\"Мужчина перед зеркалом\""
    },
    {
        "id": "name:f1f505931e15d3aeebcb081edf9a1160",
        "text": "\"ПОЕЗД \"ОДЕССА-МАМА\"\" В ГЕРМАНИИ."
    },
    {
        "id": "name:8d804836935fffbd3cc51ef960cebfb5",
        "text": "\"ОСТРОВУ СОКРОВИЩ\" - 30 ЛЕТ"
    },
    {
        "id": "name:1ab372868be66477bb688ecc1da561bf",
        "text": "З ДНЕМ НАРОДЖЕННЯ!"
    },
    {
        "id": "name:eda3e304bf644e8240f2b8dd076dc33e",
        "text": "ИНТЕРЕСНЫЕ ЛЮДИ"
    },
    {
        "id": "name:64ac4d7badcaadd2a7baf3b0d0310abd",
        "text": "«ОСТРОВ СОКРОВИЩ» СОБРАЛ АНШЛАГ"
    },
    {
        "id": "name:1e30fe6479de431e0864a6739746c3fa",
        "text": "ОМКФ-ДЕТЯМ"
    },
    {
        "id": "name:b62c0104dc961fa867a64af2c52d2cdf",
        "text": "\"ПОДОРОЖНИКИ\""
    },
    {
        "id": "name:44e5c07621c791c509def9541398068f",
        "text": "ВИННИЦиАнский кинофестиваль"
    },
    {
        "id": "name:e2dc1b0cbc66da7a8dc4e7e5dad0909f",
        "text": "V \"NEXT\" - ОТКРЫТ"
    },
    {
        "id": "name:563d6abff351488124edbf536eccbc64",
        "text": "МАСТЕР-КЛАСС ОТ АНДРИЕНКО"
    },
    {
        "id": "name:401d66699e300dcd9309823454069e13",
        "text": "ПОДОРОЖНИКИ "
    },
    {
        "id": "name:abcec78e8b85fa3c0369d61bf7a1b843",
        "text": "V «Общественный проектор» "
    },
    {
        "id": "name:938cbbd51eadbcc054837ccca6770645",
        "text": "МУЖЧИНА ПЕРЕД ЗЕРКАЛОМ 2018"
    },
    {
        "id": "name:9051de8c16dbb4e58d577d353f574352",
        "text": "Солдата Швейцман шагает по стране"
    },
    {
        "id": "name:4e22b9fbb5b78485605f5ef5992e56ac",
        "text": "ГОДОВЩИНА"
    },
    {
        "id": "name:895ed2b7e86ba2ac03179f82cb26d408",
        "text": "МНЕНИЕ ЗРИТЕЛЯ"
    },
    {
        "id": "name:4f36a39d773cb9734a4bfeb349ffa2b2",
        "text": "Продюсер"
    },
    {
        "id": "name:815ec3faf22519fac4f845c2d368c3d5",
        "text": "ДУРЕНЬ-ПРОДЮСЕР"
    },
    {
        "id": "name:e05e5ac3a6859cf67fdcb972a5974703",
        "text": "МАРШРУТЫ СУДЬБЫ"
    },
    {
        "id": "name:4c71d8aab80b410aeae311c5189ff647",
        "text": "Маршруты Судьбы"
    },
    {
        "id": "name:4d9a4b831db79252bdfbe49891b4ff03",
        "text": "Маршруты судьбы"
    },
    {
        "id": "name:ff41f30db28e8df672f5892868516724",
        "text": "ГОДОВЩИНА ПРЕМЬЕРЫ!"
    },
    {
        "id": "name:d957f1f29501ec2abb0c90afad8fbbe2",
        "text": "СТОП! СНЯТО!"
    },
    {
        "id": "name:260c9bae736f027acf1610e156ac249c",
        "text": "СВЕТЛАЯ ПАМЯТЬ"
    },
    {
        "id": "name:ecf5b9d62a6aa670875d9af7a10300d1",
        "text": "\"ТІК\" ВЗОРВАЛ СЕТЬ КЛИПОМ"
    },
    {
        "id": "name:a550638d9ad24140ecc3b3c4fc9dd11a",
        "text": "НАГОРОДА ЗА 44 РОКИ ПРАЦІ"
    },
    {
        "id": "name:12284e88759ddd21de5f7beb428627e5",
        "text": "КІНОХВИЛЬКА - ІІІ"
    },
    {
        "id": "name:483cff9e79968e457ae83327f84e63ef",
        "text": "\"ПОЕЗД \"ОДЕССА-МАМА\"\" - СНОВА В ГЕРМАНИИ!"
    },
    {
        "id": "name:bd8d00c82eb0b27df176c04d59bd4da6",
        "text": "\"ОБЛАКА\" В ДНЕПРЕ"
    },
    {
        "id": "name:ff410a5cff965acda04f192e7e604a2b",
        "text": "ПЕРЕМОГА"
    },
    {
        "id": "name:fc83f65ce79fbcd698cbd9890640847d",
        "text": "НОВЕ КІНО МАЙСТРА"
    },
    {
        "id": "name:7e79365c79ae4274f363acf779dea227",
        "text": "НОВОЕ НА НОВОМ"
    },
    {
        "id": "name:be6b3090755a11721290bc7f116e7d17",
        "text": "ЗВЗДА ДАВИДА ЧЕРКАССКОГО"
    },
    {
        "id": "name:680e22545cd44c4b0f4726074006773c",
        "text": "XIII-й ВІННИЦІЯнський"
    },
    {
        "id": "name:28ab9c17ff27db996869de38eb07b45a",
        "text": "ЛЕГЕНДИ ЧАРІВНОЛІССЯ"
    },
    {
        "id": "name:b2999bad1183049d97c20bb0ec6ad51a",
        "text": "\"НОМЕРА\" ОЛЕГА СЕНЦОВА"
    },
    {
        "id": "name:7b23449b8d7855e4cbda3d4ce7194b65",
        "text": "ДИТЯЧЕМУ КІНО - БУТИ!"
    },
    {
        "id": "name:9976759d5cbf886bc00450142110501f",
        "text": "МИРОВАЯ ПРЕМЬЕРА \"НОМЕРОВ\","
    },
    {
        "id": "name:7a346dad46471ebeed89a1754acb556a",
        "text": "Номера"
    },
    {
        "id": "name:56eb04e1c0862b29f900b1b63e4a5e33",
        "text": "HOLLYWOOD УКРАЇНСЬКОЮ"
    },
    {
        "id": "name:2e52021466dabf10a5b1ca32cd425ad0",
        "text": "СВЕТ ЗВЕЗДЫ ДАВИДА"
    },
    {
        "id": "name:8e03e76b61276309a4055aebc016bf6d",
        "text": "SWEET.TV ДАРУЄ СВЯТО ДІТЯМ!"
    },
    {
        "id": "name:447265c47a69b30b9009c241723037f9",
        "text": "НАРЕШТІ!"
    }
]