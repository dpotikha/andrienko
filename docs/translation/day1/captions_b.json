[
    {
        "id": "cap:6f6a13b601fbb6465b9d2f225ddb6291",
        "text": " \"Бригада 10 лет спустя\""
    },
    {
        "id": "cap:e343eb28ac4815fccf5a2c6df40b46cd",
        "text": "Пародия не пощадила даже Александра Цекало"
    },
    {
        "id": "cap:3a3263eadc80f6078316e0dc12ba3690",
        "text": "\"Гардымарины против мушкетеров\""
    },
    {
        "id": "cap:7711bb6408353810c527775b6193fe49",
        "text": "Звездный \"Ералаш UA\""
    },
    {
        "id": "cap:4ef89ebd2b53519c2de67f3fe55e5888",
        "text": "\"Шоу Дохтора Комаровского\""
    },
    {
        "id": "cap:31e32a713e81b64d0eac8ab61f1a960a",
        "text": "Встреча Анжелины Джоли с Борисом Грачевским"
    },
    {
        "id": "cap:e5b0bf32b541437e9adebd27f185c703",
        "text": "Руслан Сорокин на вручении ТЕФИ 2010"
    },
    {
        "id": "cap:1df282f5ae2b08c1c44092b2b83efab0",
        "text": "Пародия на \"Кривое Зеркало\""
    },
    {
        "id": "cap:f206673acd6ee468874e2ee1233b4892",
        "text": "Пародия на..."
    },
    {
        "id": "cap:1564220bfe9a36694a5a4af129929545",
        "text": "Труппа \"Великой різниці\""
    },
    {
        "id": "cap:d38888a502447495bf37e15fa1d46907",
        "text": "Пародия на \"Фабрику звезд UA\""
    },
    {
        "id": "cap:6eaeed733e3b0e21075d71c3f897d06d",
        "text": "Пародия на \"Доктора Хауса\""
    },
    {
        "id": "cap:717c0d75e6436bc2bf81cdee85275801",
        "text": "Герои Александра и Виктора Цекало..."
    },
    {
        "id": "cap:6c18ade73b8d9813d5b454f839f180a9",
        "text": "Труппа \"Большой Разницы по украински\""
    },
    {
        "id": "cap:bd9b702fd8bfe31eb8d1a8e20810a2c6",
        "text": "Приз за лучшую юмористическую программу 2010 г."
    },
    {
        "id": "cap:0f9d35e30708fa70adeafef5fca21339",
        "text": "Азиза Ибрагимова"
    },
    {
        "id": "cap:ff388154d977f07f9fbbdf4059e18fc8",
        "text": "семья Орловых"
    },
    {
        "id": "cap:8d888a955a687abf59b9e217daae1f91",
        "text": "В.Андриенко, Георгий Конн, И.Письменный"
    },
    {
        "id": "cap:0715fa3a979da6be351ca278b8abc756",
        "text": "Вячеслав Гиндин, Игорь Арнаутов"
    },
    {
        "id": "cap:8a92ebfca54139225108cc85b5def123",
        "text": "Первый съемочный день \"ТАРЕЛКА\""
    },
    {
        "id": "cap:c85b49ad403f846a7bbaea5d3caa0ce4",
        "text": "Василий Бендас, Виктория Чигирина"
    },
    {
        "id": "cap:87157789d745111cf03963a0e7afcce3",
        "text": "\"Елка в Кремле\""
    },
    {
        "id": "cap:c46c5ea76b5164b9e601045f8b97e425",
        "text": "\"Семейная жизнь Валерии\""
    },
    {
        "id": "cap:26f05f2d8eece920531390bba268c000",
        "text": "\"Морские дьяволы\""
    },
    {
        "id": "cap:1170f3f8b031f63daa3c5af89e16dc3d",
        "text": "\"Украина слезам не верит\""
    },
    {
        "id": "cap:f24ce41fa6d65e3d177d9692845abdc5",
        "text": "\" ЕРАЛАШ для ВТБ\""
    },
    {
        "id": "cap:fb28a322d22f6317f4207fef9c21b0fa",
        "text": "\"Люди в черном\""
    },
    {
        "id": "cap:1a471c89b080b2ddb00ccda231b95616",
        "text": "\"Квартирный вопрос\""
    },
    {
        "id": "cap:d089ada5048665ad03b7c2eaf46014f8",
        "text": "\"Жизнь прекрасна\""
    },
    {
        "id": "cap:2d844d84ed7b1f67dabdedbced76a996",
        "text": "Оператор-постановщик Игорь Иванов"
    },
    {
        "id": "cap:7901b71615b82454a2f9783c2354f72e",
        "text": "Наталья Гнитий"
    },
    {
        "id": "cap:47bdc08bdbc0741dee4085702123509e",
        "text": "Михаил Ильенко  и Виктор Андриенко"
    },
    {
        "id": "cap:ad85d4cf250048cf094eef8e4d3b5804",
        "text": "Виталий Линецкий"
    },
    {
        "id": "cap:8c27a92ec40055c2c1c7bb2a8bf8c9d2",
        "text": "\"Неудержимые\" и реакция Пети Черного"
    },
    {
        "id": "cap:fb581359881a18418283d24878998c33",
        "text": "Сьемочная группа проекта"
    },
    {
        "id": "cap:1d8da1b2e1c659760389242347b58941",
        "text": "Петр Черный и Виктор Андриенко на съемках"
    },
    {
        "id": "cap:08ab50d54b78ab3a413809dc41b90c0f",
        "text": "С Ларисой Долиной в мюзикле \"Любовь и Шпионаж\""
    },
    {
        "id": "cap:eeff7dc52681611cdf6e8bc64b445437",
        "text": "Пуаро"
    },
    {
        "id": "cap:c1676f3c761db628520b162dcbacef3a",
        "text": "Замахнулись на святое на \"Долгоносиков\""
    },
    {
        "id": "cap:a2d3539d101c2b1decfd4e6c8182880a",
        "text": "Два Владимира Бабешки в одной кровати"
    },
    {
        "id": "cap:f60f31a9d97a34d5236336a022d118b4",
        "text": "Два Сергея Сивохи на один сценичный метр"
    },
    {
        "id": "cap:0e4953f910cef0339faa648a3e866210",
        "text": "Кролики это не только Данилец и Моисеенко"
    },
    {
        "id": "cap:7f4f3f7b6a33251e84674b6aa2be1506",
        "text": "Лучшие детективы мира"
    },
    {
        "id": "cap:d45b666c1356035111378ea8c84e8a25",
        "text": "Сериал \"Друзья\""
    },
    {
        "id": "cap:bae762eb7904af30a6f48c9f58ee2ce4",
        "text": "...и все, все, все"
    },
    {
        "id": "cap:5ec8490f532ce082575d3c3e2869f222",
        "text": "Пресконференция жюри"
    },
    {
        "id": "cap:5b756b7794a98bc6225b4c7b3356a39a",
        "text": "Сергей Беликов без которого фестиваля бы не было"
    },
    {
        "id": "cap:a95d111a5c9bc892748fa838991cd027",
        "text": "Угадайте кто?"
    },
    {
        "id": "cap:a1ce53db9ab3313a3c17d8df1badb755",
        "text": "Создание гримма"
    },
    {
        "id": "cap:a0bd8119e0dc6476b3b6b6e983c64663",
        "text": "окончательный персонаж"
    },
    {
        "id": "cap:0d2c1fa293217b5ea01ea28de71db410",
        "text": "С мастером гримером Татьяной Горбуновой"
    },
    {
        "id": "cap:7add622c8aabc1ecfe12c96b445f8bcd",
        "text": "Приз Анатолию Матешко \"Лучший игровой фильм\" "
    },
    {
        "id": "cap:53339e41d8923988d8adeefba61df49d",
        "text": "Приз Богдану Ступке вручила Лидия Федосеева-Шукшина"
    },
    {
        "id": "cap:962161bbb3d011f23930f0cc39c1b790",
        "text": "Лев Дуров вручил приз – Катерине Гусевой "
    },
    {
        "id": "cap:d84cba77b3d4b0dd96d28ceeae6d0c18",
        "text": "Награда из рук Виктора Андриенко."
    },
    {
        "id": "cap:288842ebad4a685f41083b98dd72bf00",
        "text": "\"Отцы основатели кинофестиваля\" Андрей Лопушанский,Константин Стогний"
    },
    {
        "id": "cap:5ef12db639b6df37814888aac844a89c",
        "text": "Владислав Кичкун получает награду из рук Виктора Андриенко"
    },
    {
        "id": "cap:9e933c598ad94739a39f35c6606411a1",
        "text": "Удачи победителям"
    },
    {
        "id": "cap:3dd6dfd16688a8c9207257e889ec3ec6",
        "text": "Пародия на программу \"Жить здорово\""
    },
    {
        "id": "cap:beff4bba0595a4ab3ae55daaf563b637",
        "text": "\"Золотой летающий слон\" пятого фестиваля"
    },
    {
        "id": "cap:eb01eeea53c5ad9bf40e4e6609281754",
        "text": " Виктор Андриенко и Светлана Галка в образах \"Пригожина и Валерии\""
    },
    {
        "id": "cap:e04eca840483f30e48a0eb4c81628dc3",
        "text": "Виктор Андриенко в пародии на сериал \"12 стульев\""
    },
    {
        "id": "cap:ff1c6195b021da5b59473dee008ea3f3",
        "text": "Скоро \"Большая разница в Одессе\""
    },
    {
        "id": "cap:944336b364dca275425d48e1822bb9ae",
        "text": "Пародия на \"Гари Потера 4\""
    },
    {
        "id": "cap:829a3c1b8f7d83000225dcabe8a165ce",
        "text": "Евгений Никишин в пародии на квосточные боевики"
    },
    {
        "id": "cap:5eee32bcc9161b51523ef7286e742c61",
        "text": "С режиссёром Юрием Владовским"
    },
    {
        "id": "cap:8028bf3598153348dbbd6f5f19a5d46a",
        "text": "На площадке режиссёр Дмитрий Дьяченко"
    },
    {
        "id": "cap:ded85eb85aef8d6e05dcd86065e40518",
        "text": "Криативный продюсер Руслан Сорокин"
    },
    {
        "id": "cap:dfc7f92387c8e707a30b4b82f3012244",
        "text": "Художник гример Виктор Тамбовкин за работой"
    },
    {
        "id": "cap:cbd13fa891cae5a03b7269a97d92e7c0",
        "text": "Последствия грима"
    },
    {
        "id": "cap:77e7c9ff75cf0f2ac17e49bb2c479064",
        "text": "\"Хованки\" Юрий Горбунов"
    },
    {
        "id": "cap:b4501a963e626809b36072050275a610",
        "text": "Юрий Горбунов в кадре"
    },
    {
        "id": "cap:3a9c6870a4d73ba4553e1715446b493a",
        "text": "Анатолий Барсюк и Виктор Андриенко в 2007 г."
    },
    {
        "id": "cap:76289e55013cd37a234464260c8b74bc",
        "text": "\"Хованки\" Виктор Андриенко"
    },
    {
        "id": "cap:b3ac520a0d9a85b93e669616823a9102",
        "text": "Виктор Андриенко за кадром"
    },
    {
        "id": "cap:7921302d0d11c4752a4e813694f2c445",
        "text": "Евгений Майданик вручил Виктору Андриенко очередного \"слона 2011\""
    },
    {
        "id": "cap:166220e61517ef6d9861c67a442a4bde",
        "text": "Финал юбилейного фестиваля"
    },
    {
        "id": "cap:eae6eecff4c36a6afe51f51dda76cb5b",
        "text": "За праздничным столом. "
    },
    {
        "id": "cap:4078d1bf14eecc8f02abbf6e857d4929",
        "text": "Владимир Кисаров, Александр Лобанов, Виктор Андриенко, Дмитрий Малашенко, Владимир Жуков"
    },
    {
        "id": "cap:06e1aadfce8a3381dcd2851eb72f13b4",
        "text": "Кадр из фильма 1986 г."
    },
    {
        "id": "cap:ddf89143e66537ac3920f49472b3836d",
        "text": "Виктор Андриенко с организаторами праздника"
    },
    {
        "id": "cap:7cf08facba2d6afa9fd2742cbc457332",
        "text": "Любовь Тихомирова, Оскар Кучера"
    },
    {
        "id": "cap:061d14d48cac705a2d8cba8df570196c",
        "text": "Продюсеры \"Великой Рызницы\" - Виктор Медвецкий и Сергей Атрощенко"
    },
    {
        "id": "cap:bcdd8cdf132e4f383301424149f8edcf",
        "text": "Виктор Андриенко в роли Шефа Леры"
    },
    {
        "id": "cap:3f18d9807dc902fce0bd32c678d5a9f1",
        "text": "Хрюндиков во всей красе"
    },
    {
        "id": "cap:676a475837b72a9e10b2711e815060e7",
        "text": "Алла Сергийко в роли Жозефины"
    },
    {
        "id": "cap:225fbd372a0fc6891d94fa0c8e2ceabc",
        "text": "Владимир Филипов - Продюсер проэкта"
    },
    {
        "id": "cap:7198291e8228f5ec9a5d74888a6f981d",
        "text": "Алена Узлюк"
    },
    {
        "id": "cap:23022595814c97625d7467b4bb7d59fa",
        "text": "Томара Яценко и Евгений Шишкин"
    },
    {
        "id": "cap:b899addb4b7b365aac428224f0bdb8d9",
        "text": "Кто кому кто?"
    },
    {
        "id": "cap:fd9f6424f256215f4262366bdb8c5991",
        "text": "На премьере Михаил Ильенко, Владимир Филипов"
    },
    {
        "id": "cap:c2f0e4f004661f2e310762675e5e6155",
        "text": "Виктор Андриенко, Олег Примагенов"
    },
    {
        "id": "cap:023969bd2c9ad7d1e6077d1dc627b1b4",
        "text": "Михаил Ильенко"
    },
    {
        "id": "cap:f4a93ea475e598a8924783c33bb7ce3d",
        "text": "Дмитрий Леортович"
    },
    {
        "id": "cap:0276fe148cd781e436e9a4c417dca71e",
        "text": "Ольга Гришина"
    },
    {
        "id": "cap:e4ab1d6273b49baea4d15d921a269412",
        "text": "Иванка Ильенко"
    },
    {
        "id": "cap:d38a48e4543d7acc5cd06bea8025b86d",
        "text": "Виктор Андриенко в роли полковника Смирнова"
    },
    {
        "id": "cap:79a9630159b926abf15f62c79d540884",
        "text": "Съемочная группа на премьере фильма в Полтаве"
    },
    {
        "id": "cap:3dc514a2402873acf2b21a1729bac8fb",
        "text": "Виктор Андриенко, Николай Добрынин, Виктор Сарайкин в сериале "
    },
    {
        "id": "cap:f065ae23a29f89d1a958dc0592cdacb2",
        "text": "Владимир Филиппов, Дмитрий Линартович в Житомере"
    },
    {
        "id": "cap:2660698cf2c2426a1632ce7a26dd255d",
        "text": "Виктор Андриенко, Дмитрий Линартович, Михаил Ильенко, Владимир Филиппов во Львове"
    },
    {
        "id": "cap:6af9ba5fbade63ef1f95bd5cac8c630f",
        "text": "Алексей Колесников премьера  в Донецке"
    },
    {
        "id": "cap:97609ee1b1b7b097cdfc55a85cd125ee",
        "text": "Алексей Колесников и Андрей Суярко на встрече со зрителями в Донецке"
    },
    {
        "id": "cap:8e3e057ce6c097bc9a86d6087fb63df3",
        "text": "Съемочная группа на встрече с прессой Одессеы"
    },
    {
        "id": "cap:94d0bd7f579485ac0d748169e5089cfb",
        "text": "Актеры Александр Данильченко, Александр Игнатуша и сценарист  Андрей Ильков"
    },
    {
        "id": "cap:745d981b958bffda77e244675d43bbc1",
        "text": "Актер  Николай Добрынин, режиссер Алексей Кирющенко, продюсер Андрей Яковлев"
    },
    {
        "id": "cap:4f2cd7635026f20e950c9f53003617f1",
        "text": "Группа подержки фильма в Сімфірополе к\/т \"Спартак\"."
    },
    {
        "id": "cap:179b22ccf040b6cebe0fd1f4cf1cb03f",
        "text": "Игорь Маркович Скоробогатов - ТотХтоПокозалУкраинскоеКино в Крыму!"
    },
    {
        "id": "cap:5b0fa97ddecf2a3fa34d286fe211986e",
        "text": "Первый сеанс фильма в Евпатория к\/т \"Ракета\"."
    },
    {
        "id": "cap:225ef17a5dfd5224565becd8983a39ea",
        "text": "Запись эфира на телеканале ГТРК Крым!"
    },
    {
        "id": "cap:07fa60b4f8dc57707e348e669b784c01",
        "text": "Гала концерт"
    },
    {
        "id": "cap:16e5a34db361a1a9feecd60a476ebbf0",
        "text": "\"Спасибо\" (г. Номосковск, Россия)"
    },
    {
        "id": "cap:82d3ff35ba1810145d166de7ab167b83",
        "text": "Игорь Письменный, Татьяна Иванова и Вадим Набоков"
    },
    {
        "id": "cap:4c3f97bdcc475bb07bcb48721351fe0d",
        "text": "\"Будильник\" (г.Запорожье, Украина)"
    },
    {
        "id": "cap:156494980b65dedb76d4fbeda4347327",
        "text": "Василий Бендас в жюри"
    },
    {
        "id": "cap:46a29d0211269e1cbd9b1f0b86ee46f0",
        "text": "\"Подвал\" (г.Воронеж, Россия)"
    },
    {
        "id": "cap:893bb570b72b026c3aff2292b5aecc2b",
        "text": "\"Не гении\" (Днепропетровск)"
    },
    {
        "id": "cap:c5138611d8cc69bd31f75ace958a0252",
        "text": "Виктор Андриенко и Олег Григорьев"
    },
    {
        "id": "cap:3b8ca50be07d3be1eaf9987e60b57a28",
        "text": "СТЭМ без девушек третьекурсниц - не возможен!"
    },
    {
        "id": "cap:9ce8e22781beee8bb0732ec9432d1dd9",
        "text": "\"Истоки\" (г.Рыбинск, Россия)"
    },
    {
        "id": "cap:ca001bf16d6c673e2b4e388f5b0d970a",
        "text": "Бодро и весело...."
    },
    {
        "id": "cap:49541085d7262a370d2751b6e9b6d9cd",
        "text": "Веселое жюри фестиваля"
    },
    {
        "id": "cap:5fe71cd71a0f609b95226bfbb9ba1d88",
        "text": "Памятник Ивану Фирцаку"
    },
    {
        "id": "cap:a73172f43781f6e0581a010389b522f9",
        "text": "Игорь Кондратюк - Дарвiн"
    },
    {
        "id": "cap:a92ba328967894aa619f37a9a9208bac",
        "text": "Фагот - Капитан"
    },
    {
        "id": "cap:931dd4ce4cafd803a5b844f6ea2888b3",
        "text": "Виктор Андриенко - Бульбонic"
    },
    {
        "id": "cap:f7830e101ea93c3616faff56fcbfd19c",
        "text": "\"Одесса 1985 года\" Делиев+Андриенко"
    },
    {
        "id": "cap:ed9950506830d5e9eedcccec3ca592ad",
        "text": "Гости фестиваля"
    },
    {
        "id": "cap:fa605342f632a18d75949a21b4858031",
        "text": "Награды за полгода"
    },
    {
        "id": "cap:99d9901bdd4656a93ffa5f6c1f50cc00",
        "text": "Группа"
    },
    {
        "id": "cap:d489c5b85de59fb427c5838a562992cd",
        "text": "Благодарность осноположникам \"Коронации слова\""
    },
    {
        "id": "cap:b8118718ccaa2bfb3f365da406a22641",
        "text": "Благодарность Владимиру Филипову что предложил написать сценарий."
    },
    {
        "id": "cap:f41e87ca49133d5dfdfa32e89448961c",
        "text": "Благодарность соавтору Игорю Письменному"
    },
    {
        "id": "cap:5de59803b2f1543ccd75aca6720e980c",
        "text": "Михаил Ильенко в свои 65"
    },
    {
        "id": "cap:7b978738e0b9e4ea94702c8ccaf247cb",
        "text": "Михаил Ильенко и Виктор Андриенко на съмках"
    },
    {
        "id": "cap:be18d366a66d3a419ebce5b12c1ffa38",
        "text": "Виктор Андриенко и Дмитрий Халаджи на красной дорожке фестиваля."
    },
    {
        "id": "cap:8ed53a63499db81fe7ef4df55c65776c",
        "text": "Виктор Андриенко, Владимир Филипов на защите проекта"
    },
    {
        "id": "cap:f161196ff9b05710503a8e149f75bb71",
        "text": "Члены жюри конкурса проектов."
    },
    {
        "id": "cap:57f3ed9257cfb30a0e4b08e71126c3f4",
        "text": "Дмитрий Халаджи в визуальном тизере."
    },
    {
        "id": "cap:2c660a8cdc9a4e262fc62349693e6d06",
        "text": "Новый очередной рекорд Дмитрия Халаджи."
    },
    {
        "id": "cap:a023c96bdf78bf012acd8a625fb8b96b",
        "text": "Одесские витражи..."
    },
    {
        "id": "cap:d7486558ca17beb44706d8e0cb2a6dec",
        "text": "Кум Игорь Письменный с именинником"
    },
    {
        "id": "cap:40a0c67dd055bb80cf544f9ae3a92178",
        "text": "Оператор постановщик Александр Криштолович и Виктор Андриенко у памятника Фирцаку-Кротону"
    },
    {
        "id": "cap:22b1d13a23d742b266f44aee822686bf",
        "text": "Дмитрий Халаджи с почитателями таланта"
    },
    {
        "id": "cap:4a3976f0b0d61240ed8db6276c72580d",
        "text": "Виктор Андриенко с \"Иваном Силой\""
    },
    {
        "id": "cap:c38cb854fa472462d3d913eb2e566c38",
        "text": "Сергей Романюк и Виктор Андриенко на съемках"
    },
    {
        "id": "cap:477c54ca4e670456efa9680f18690a54",
        "text": "\"Иван Кротон\" в исполнении Сергея Романюка"
    },
    {
        "id": "cap:d97ae80c5ebdff459b71ef7b992bb9df",
        "text": "Крайний съемочный день."
    },
    {
        "id": "cap:d8e06f8a51f217191955b78390d98a41",
        "text": "Александр Олешко в пародии \"gagman style\""
    },
    {
        "id": "cap:ff1185c7a025bd80835958397c455b8c",
        "text": "Известные голоса: Джим Хокинс - Валерий Бесараб, Капитан Смолит - Виктор Андриенко"
    },
    {
        "id": "cap:43b159405593821e535cb5c1510aad74",
        "text": "Иван Ургант в госях у Александра Цекало на экране Виктор Андриенко"
    },
    {
        "id": "cap:cffa58a913b10ac02440de77d366107c",
        "text": "Виктор и Иван"
    },
    {
        "id": "cap:0ce8d8e7a9635551a89b20b395c60d29",
        "text": "приглашение на чешский фестиваль детского кино"
    },
    {
        "id": "cap:2748783cb4536ee0f7c4a65fd0ffd28f",
        "text": "Игорь Стецюк"
    },
    {
        "id": "cap:9b45cc5fab1013a98789f1281463fe9b",
        "text": "Олег Михайлюта - Фагот"
    },
    {
        "id": "cap:d983933ad5a51b59fa82bb5f98ff51d6",
        "text": "Группа в монтажной КИНОТУРА"
    },
    {
        "id": "cap:200a9949f7c2beabe557b00a1c35ee2d",
        "text": "Виктор Андриенко сегодня на церемонии"
    },
    {
        "id": "cap:1c7166a0cb23a21270cff096e312a059",
        "text": "Ани Лорак"
    },
    {
        "id": "cap:0409dc98e92bd80dd4beb388d419e08a",
        "text": "Актер БР: Кирил Андреев в роли Ивана Дорна"
    },
    {
        "id": "cap:69689925e6536d2787fd57399142ddf8",
        "text": "Иван Дорн (настоящий)"
    },
    {
        "id": "cap:536650945cd4adc5ac545622b14f082b",
        "text": "Пресс-конференция с жюри фестивааля"
    },
    {
        "id": "cap:965b9092257595662bcbe356760d6925",
        "text": "Жюри: Татьяна Иванова, Сергей Алимов, Вадим Набоков"
    },
    {
        "id": "cap:72b62a21bdd95b1135299bbd685c60f3",
        "text": "Игорь Стецюк во время записи"
    },
    {
        "id": "cap:9dbb7b89268266138a93f6e26c064ec9",
        "text": "Вячеслав Гиндин в образе Доктора Новака"
    },
    {
        "id": "cap:f290707850ac73b9d4feead7907e98e2",
        "text": "Дмитрий Халаджи во время фотосессии"
    },
    {
        "id": "cap:155900525636548bbd40684f7021813a",
        "text": "Владимир Комаров и Борис Барский на дубляже своих ролей."
    },
    {
        "id": "cap:455714ed7a83bf6f231f9d48117ae75d",
        "text": "Актеры студии \"L*doen\" на дубляже массовых сцен"
    },
    {
        "id": "cap:be35064e4d4e1fb5c9485e040263dc19",
        "text": "Плакат этого события"
    },
    {
        "id": "cap:9f47df6bde941824c067b2f87b65e013",
        "text": "Алла Сергийко"
    },
    {
        "id": "cap:e24582281802ccb315f6ffd138b5c4b1",
        "text": "Вадим Скуротовский"
    },
    {
        "id": "cap:7b3dee19a5a32c67ecf8fd16b828ef39",
        "text": "У журналистов на интервью Виктор Андриенко и Игорь Письменный."
    },
    {
        "id": "cap:9a60f2991c07e9a83b6d738f3c2b7e05",
        "text": "Красная дорожка фестиваля."
    },
    {
        "id": "cap:74b383afd0e652e976ed3012b202c992",
        "text": "Презентация фильма \"Иван Сила\" перед участниками фестиваля и журналистами \"Бригантины\"Приморск, 6 июня 2013"
    },
    {
        "id": "cap:a80a0a981283fef0f396965f10c7be62",
        "text": "Дмитрий Халаджи, Василий Вирастюк, Виктор Андриенко и продюсер фильма Владимир Филиппов."
    },
    {
        "id": "cap:99a1d43c41aaa091076421ecd6e9d3cd",
        "text": "Съемка 1986 года. "
    },
    {
        "id": "cap:3db79dc68020bbf59a2a3189c395b464",
        "text": "Традиционное разбивание тарелки в первый день съемок."
    },
    {
        "id": "cap:fd6187c6456f11fb72dbb7ecf87027aa",
        "text": "Виктор Андриенко и Ольга Полякова работают над образом Эллы Фитцджеральд"
    },
    {
        "id": "cap:d3c19f2f1ae958bd7034e3f6c1ce990d",
        "text": "Жюри фестиваля."
    },
    {
        "id": "cap:0e0c89e772b7e6722f1261c2b6f5634a",
        "text": "Зрители..."
    },
    {
        "id": "cap:272b6a84c35c2b59bc61db9d49f96685",
        "text": "Украинкие члены жюри с зам президента фестиваля Биайны Даниелян"
    },
    {
        "id": "cap:d49599c34ba24b2b1582626afe56348a",
        "text": "Владимир Зеленский, Елена Кравец и Евгений Кошевой."
    },
    {
        "id": "cap:f8e7dd0c922a8fa8309f0b77dda5c4a2",
        "text": "Семья Мэра..."
    },
    {
        "id": "cap:582dffa98236bb56e9ffb7d49c1816de",
        "text": "Внутренний мир Мэра..."
    },
    {
        "id": "cap:279c53026d71c5530113bca9ca2abe9b",
        "text": "Мэр и его электорат..."
    },
    {
        "id": "cap:57b101137cb21a478abb22d472309998",
        "text": "Игорь Павленко, Виктор Андриенко, Артем Давыдов."
    },
    {
        "id": "cap:b9baf2b4c1917ca5a7f5e930b975f731",
        "text": "Игорь Письменный в роли Пандорского в фильме \"Иван Сила\"."
    },
    {
        "id": "cap:08d37d4cba935e208dd141cab32effa6",
        "text": "Владимир Комаров и Борис Барский 1984 г.."
    },
    {
        "id": "cap:862f5709b0ee19d15b56718ae2d6745e",
        "text": "Владимир Комаров и Борис Барский лихие 90-е годы."
    },
    {
        "id": "cap:50115acf05cb1fe71490c95e170081ae",
        "text": "Владимир Комаров и Борис Барский 2013 г.."
    },
    {
        "id": "cap:2355b2b4e34491f0ad31e5b7d097824a",
        "text": "Владимир Комаров и Борис Барский на премьере фильма \"ИВАН СИЛА\" в Одессе."
    },
    {
        "id": "cap:7a8a3f377671ce6599282284b56f3e94",
        "text": " Перед показом фильма \"ИВАН СИЛА\""
    },
    {
        "id": "cap:ea33c4feafc77270d4ac062ed95c9ba5",
        "text": "Встреча в украинском посольстве."
    },
    {
        "id": "cap:15d5be73ccfe245969b7b9e99f0caa6f",
        "text": "На \"Boyana Film Studios\""
    },
    {
        "id": "cap:26939cd424e58de09b68cea20f802da7",
        "text": "В Доме Кино Болгарии."
    },
    {
        "id": "cap:6c040b9a9b25a557550610f9fc14deca",
        "text": " Игорь Письменный вовремя съемок с актерами Дмитрием Халаджи и Вячеславом Гиндиным"
    },
    {
        "id": "cap:e50123e0e5f574bcf0f66f45ccec7d29",
        "text": "Игорь Письменный перед показом фильма"
    },
    {
        "id": "cap:5ea1f067d2dbbb97e05108e23b5a0b76",
        "text": "Письменный в роле Пандорского"
    },
    {
        "id": "cap:a2a95fee288958c284d30ab2a821434d",
        "text": "Автграфсессия"
    },
    {
        "id": "cap:8b86d4e5c1bf30f9973623a6f9eb54a8",
        "text": "Съемочная группа фильма на премьере в г.Запорожье."
    },
    {
        "id": "cap:992edfcd243975397fda69729935abf3",
        "text": "Режиссер Итыгилов на съемочной площадке."
    },
    {
        "id": "cap:8edb64569b7db9a254baf6d32791cecf",
        "text": "Олег Филимонов"
    },
    {
        "id": "cap:5c2c1bf1a7cebd8f15f34dc49e67e82d",
        "text": "Владимир Филиппов продюсер"
    },
    {
        "id": "cap:d5b4eeaddceb59586e75682bc2cb12d0",
        "text": "Стивена Фрирза наградили «Золотым Дюком»."
    },
    {
        "id": "cap:0b2055a229421e0f60111d4f44985cbf",
        "text": "Олиас Барко."
    },
    {
        "id": "cap:8a13f85ec051fa5ce74c22a97ba7742c",
        "text": "Владимир и Валерий Чигляевы"
    },
    {
        "id": "cap:b247b647d13d7e05e3b1674e11413d4f",
        "text": "Олег Примогенов"
    },
    {
        "id": "cap:5d018db45cb6fdda917af8d4045b811c",
        "text": "Елена Кривда"
    },
    {
        "id": "cap:9e6d1e7362c6faa0dcf9b713807eb686",
        "text": "Николай Баклан"
    },
    {
        "id": "cap:0f758acac1975f6279c053277fa9e861",
        "text": "Валик"
    },
    {
        "id": "cap:80668bc14147fc5d1a3a683928e6ec38",
        "text": "Съемочная группа фильма."
    },
    {
        "id": "cap:e8e1b94f27185829bb79538cca4123b5",
        "text": "Алексей Вертинский и Виктора Андриенко в кадре."
    },
    {
        "id": "cap:5979202379865711f03f12d0e14c0b4f",
        "text": "Виктор Андриенко и Евгений Шишкин на съемочной площадке."
    },
    {
        "id": "cap:c0210068f159cfe7b514922c4db81e1a",
        "text": "Руслана Писанка, Виктор Андриенко, Олег Филимонов"
    },
    {
        "id": "cap:ba3dccc77bd04f4ea90dc60dd44803a2",
        "text": "Режиссер Игорь Славинский"
    },
    {
        "id": "cap:2cb3677b4fdbef06d1485467fa5ee8ae",
        "text": "Аня Ткач"
    },
    {
        "id": "cap:d1e8ef03fccbf6d42a390bb6b5d515a2",
        "text": "В киноклубе PINTAGON"
    },
    {
        "id": "cap:762b60359795da1d786a360a98016041",
        "text": "Воспоминание о съемках перед сеансом..."
    },
    {
        "id": "cap:8b40de662c33a6dc0cff6d87c61388e0",
        "text": "Выберайте места..."
    },
    {
        "id": "cap:10dd33bf7dc9315e2d467c5c51522697",
        "text": "Ярослав Биляев и Виктор Андриенко на финальной игре КВН \"ОТКЛИК\"."
    },
    {
        "id": "cap:4fbcead46eed086516ae33c97bdc24b3",
        "text": "Виктор Андриенко и Ярослав Биляев на пресс-конференции"
    },
    {
        "id": "cap:3743f2a4c4aecbffeca8f682dadc9b42",
        "text": "Виктор Андриенко в роли Урядника."
    },
    {
        "id": "cap:154c26cfa2e2cc6cce51943d866342a7",
        "text": "Олег Филимонов, Руслана Писанка и Виктор Андриенко"
    },
    {
        "id": "cap:2030b0043b29352e8ffc8657bd1fc79d",
        "text": "Ярослав Биляев, Виктор Андриенко и Василий Вирастюк на встрече"
    },
    {
        "id": "cap:9ea50677208329fad69bc9e2a2f686d1",
        "text": "Виктор Андриенко с партнерами по съемочному процесу."
    },
    {
        "id": "cap:727e2facb1e915ec0d335ef683eb262e",
        "text": "Творческая группа фильма \"ДЕРЖИ УДАР\" на премьере в кинотеатре \"Киев\"."
    },
    {
        "id": "cap:ddaf4f27df9e7533d9703e8d16487ac9",
        "text": "Виктор Андриенко в новом кулинарном шоу."
    },
    {
        "id": "cap:74d3b683a8401eee346afa71c8cd148f",
        "text": "Анна Демьяненко, Виктор Андриенко и Яков Гоп"
    },
    {
        "id": "cap:39ccc38fa40da6902acb8170026fb1a2",
        "text": "Пресс конференция создателей фестиваля"
    },
    {
        "id": "cap:f075d39e5e3ba0793be5757487d7cf05",
        "text": "Жюри питчинга"
    },
    {
        "id": "cap:de8d8f80b5a4831f4342b3f6a68a247f",
        "text": "Так \"Камень Силы\" пролежал более 300 лет."
    },
    {
        "id": "cap:6b1ecae5d9c43e38adec7b9b55506df7",
        "text": "Поднятие \"Камня Силы\"."
    },
    {
        "id": "cap:4cde8a9b4a45cb133fbb698688432454",
        "text": "Виктор Андриенко и Александр Гаврош возле \"Камня Георгия Пинты\""
    },
    {
        "id": "cap:ba5bb201f676f3d1f81d6a45fc0956c8",
        "text": "Виктор Андриенко перед вручением приза"
    },
    {
        "id": "cap:a6f51074596d907e4d88c330eec6b0e0",
        "text": "Виктор Андриенко и Василий Вирастюк на фестивале"
    },
    {
        "id": "cap:817827b79dc0ed9bdd832bf93646db48",
        "text": "Открітие кинотеатра."
    },
    {
        "id": "cap:264a6f05c66a5ef7367816f793f51796",
        "text": "Директор кинотеатра Людмила Гордиладзе"
    },
    {
        "id": "cap:576e35a2c407edfffd7e529ae49946fe",
        "text": "Виктор Андриенко представляет киноальмонах."
    },
    {
        "id": "cap:46118cdc9519fb74b0805c88584babe8",
        "text": "Василий Вирастюк перед показом фильма"
    },
    {
        "id": "cap:a64a3c32157f9266e2676b4f9e4c2e7e",
        "text": "Жюри"
    },
    {
        "id": "cap:5eb4469ff7e4f8d91e58ec3a8145a51c",
        "text": "Жюри фестиваля"
    },
    {
        "id": "cap:5c91b85e2b068c1e9838b168e6a4a08f",
        "text": "Работа детского жюри "
    },
    {
        "id": "cap:0e472a9e7f2907b99dff9d484b14dd3a",
        "text": "Директор Одесской киностудии Андрей Зверев"
    },
    {
        "id": "cap:3e0e6a7defa937e8a0ef8ab052c87c83",
        "text": "Леонид Шевченко со зрителями"
    },
    {
        "id": "cap:9f75a68bf2cb9b1ed0669dc00cc420b0",
        "text": "Василий Вирастюк на мастер-классе"
    },
    {
        "id": "cap:1d9c0135366b982306254cc8f7983c16",
        "text": "Виктор Андриенко и Руслана Писанка на премьере."
    },
    {
        "id": "cap:fbcd1ce72d0699b14bea7087ac6f59af",
        "text": "Виктор Андриенко и Олег Сабчук"
    },
    {
        "id": "cap:48b131ef67d142a8ff659e79d7702479",
        "text": "Владимир Явненко и Константин Войтенко"
    },
    {
        "id": "cap:064d73d12913ef7339117531ff0b18ad",
        "text": "Наша труппа"
    },
    {
        "id": "cap:5a272c7f5146604a80c0b151e6cb226f",
        "text": "Наша маленькая труппа"
    },
    {
        "id": "cap:97bd4fc47942e95895da7554dd2e81a0",
        "text": "Наш зритель"
    },
    {
