RewriteEngine on

RewriteBase /
Options -Indexes

# never served: runtime caches (USERS_CACHE holds logins and passwords), old DB dumps, CLI tools, templates, classes
RewriteRule     ^(cache|backup|tools|dynamic_templates|WEB-INF)(/|$) - [F,L]
# upload folders: nothing in them may run as a script
RewriteRule     ^(files|imglib|imglib_thumbnails|content|trash)/.*\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh)(/|$) - [F,NC,L]
DirectoryIndex index.php

RewriteCond     %{REQUEST_FILENAME}     !-f
RewriteCond     %{REQUEST_FILENAME}     !-d
RewriteCond     %{REQUEST_URI} !^(/admin.*|/forum.*|/index.php*)

#RewriteRule 	^([a-zA-Z]{2})/pac.rss$ /$1/rss [L]
#RewriteRule ^([a-zA-Z]{2})(.*)?$ index.php?lang=$1&&path=$2&%{QUERY_STRING}
RewriteRule     ^(.*) index.php?%{QUERY_STRING} [L,E=REQUEST_URI:/index.php/$1]

#ErrorDocument 404 /

AddDefaultCharset utf-8