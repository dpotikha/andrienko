[
    {
        "id": "cap:2ba37a5f5c52cc2debef14f1a38e6a87",
        "text": "\"РЕКЛАМА\""
    },
    {
        "id": "cap:4723f313fca42c3b5090efe929a60e4f",
        "text": "Игорь Кистол "
    },
    {
        "id": "cap:fec32426ee1b10b160b0d5f06f52fdda",
        "text": "\"ПРИМЕТЫ\""
    },
    {
        "id": "cap:f7205469ad6215133fafd36caf7c41a0",
        "text": "\"РЕМОНТ\""
    },
    {
        "id": "cap:1f05bf9365be31a1dcf93a791bb81590",
        "text": "\"МАDE IN АМЭРЫКА\""
    },
    {
        "id": "cap:2c3784728762a0713e5c8c4496fe89d0",
        "text": "\"ГЛУХОЙ ДЖИН\""
    },
    {
        "id": "cap:96a3c0444e978cafd04a761c28a6fafc",
        "text": "На съемках с Ноной Гришаевой"
    },
    {
        "id": "cap:47e9d203f0f1cb158cd316236f7ef7ba",
        "text": "\"ДЯДЯ ИЗЯ\""
    },
    {
        "id": "cap:15e6f7b5c3702fcfe2975d3f125e9ca5",
        "text": "\"СПЯЩАЯ КРАСАВИЦА\""
    },
    {
        "id": "cap:d991255ee3cc28e9283e383b1a98bf75",
        "text": "\"ПРОДЮСАРЫ\""
    },
    {
        "id": "cap:8f005d66e0f7b4c7f233bfa53cce7e6a",
        "text": "\"ПРОРОК\""
    },
    {
        "id": "cap:c0a87e9762fe00dec3901d9e99f5e209",
        "text": "режиссер Виктор Приходько, олератор Олег Маслов-Лисичкин"
    },
    {
        "id": "cap:cbee54f34e798547e33e31492161f8fe",
        "text": "Кум Панько и Пан Кумко"
    },
    {
        "id": "cap:4ae554a9147d457c757bdb3822f1ea79",
        "text": "первый съемочный день"
    },
    {
        "id": "cap:a5e67ade99775ab1e13678f6ae4c19a0",
        "text": "Виктор Андриенко"
    },
    {
        "id": "cap:eebd123c9a658b8e217ed90d29681e66",
        "text": "Василий Бендас (Вася)"
    },
    {
        "id": "cap:a154b2ba111ebce609ef10eb23fb189c",
        "text": "Виктор Андриенко (Крысюк)"
    },
    {
        "id": "cap:429aa6e8d23677f476eab549c2891ede",
        "text": "Александр Питриченко"
    },
    {
        "id": "cap:d54d70b91cbc816da3380dbdab7cc9de",
        "text": "Виктор Андриенко и оператор Сергей Мищенко"
    },
    {
        "id": "cap:e2a1c0066d5d06a0a2549f924556517b",
        "text": "Goltis руководитель экстрим группы"
    },
    {
        "id": "cap:46d13623b16a2ed9bcb82e4db88734dc",
        "text": "Здесь живет мистер Шерлок Холм"
    },
    {
        "id": "cap:3855d12d08e8c5a0eeb1a3393aa5a484",
        "text": "В.Андриенко, В.Опалев, А.Акопян, В.Иваненко"
    },
    {
        "id": "cap:1ecf649e8ec87a94b26fcaa0cdb011d7",
        "text": "Виталий Малахов и Виктор Андриенко в 1980 г."
    },
    {
        "id": "cap:f4d77b8ffd2f4063aebe1df52417a835",
        "text": "Каскадеры: Н.Балдин, В.Воробей, С.Григорьев, В.Деменьтьев, В.Андриенко"
    },
    {
        "id": "cap:4e234e2bb2cfd71c34973aaa689b28fa",
        "text": "Виктор Андриенко, Аннна Александрович (Хозяева \"Веселой Хати\")"
    },
    {
        "id": "cap:e5758975cb4bb5f4e32584e48bc3d58d",
        "text": "Игорь Тимошенко, Виктор Иваненко"
    },
    {
        "id": "cap:95d7658ab627cf186545d6cb3a29f5a0",
        "text": "Гарик Кричевский"
    },
    {
        "id": "cap:10041adc4c23de53911efa6c7777dbf1",
        "text": "Владимир Ямненко"
    },
    {
        "id": "cap:ec2696cb7a0d255783e9d6429330846b",
        "text": "Агенты сетевого маркетинга"
    },
    {
        "id": "cap:a9d152adcc1761e00c276f2f1bd2bc9d",
        "text": "Бабай - эскиз персонажа"
    },
    {
        "id": "cap:0ff5a44cbb3aa2cc45d8d0de51e2eec3",
        "text": "Виктор Андриенко и группа \"Чай вдвоем\""
    },
    {
        "id": "cap:fc6e0aa91bdabc496c51e417e249f90b",
        "text": "Максим Леонидов"
    },
    {
        "id": "cap:0edc744b9199baa7e2b113f93685bd8d",
        "text": "Дмитрий Нагиев"
    },
    {
        "id": "cap:8c2db854345726bbbc8dbd52362a0fca",
        "text": "Группа \"Сливки\""
    },
    {
        "id": "cap:93ea8b42cae09dfedb223ad0ad2db5d5",
        "text": "Группа \"Премьер-министр\""
    },
    {
        "id": "cap:fbb9e8d3fdf6048ccf449fd863a8cf10",
        "text": "Жасмин и Алика Смехова "
    },
    {
        "id": "cap:18ba6549b912ab360f5af9e378b9bcb2",
        "text": "Группа \"SMASH\" "
    },
    {
        "id": "cap:b47f3a1bca528b3c39902edfd3a8e5bc",
        "text": "Дмитрий Нагиев и группа \"Чай вдвоем\" "
    },
    {
        "id": "cap:94409c54e595376e6d39dff8d538d83a",
        "text": "Игорь Письменій"
    },
    {
        "id": "cap:5a0ba6df9d8e3ea8b5db744d67c95191",
        "text": "Юрий Стецковский"
    },
    {
        "id": "cap:cb8c6a7b9d4bdea27d12c2269b4e97a3",
        "text": "Сергей Щербина"
    },
    {
        "id": "cap:c11cc9f6399298507b7e1ad7479fd3a8",
        "text": "...не с сусиками, а СУСИКОВ, СУ-СИ-КОВ!"
    },
    {
        "id": "cap:8bef97d14dfec3c4c4de2654837d5959",
        "text": "Потыкаев (Александр Симонец) и Сусиков"
    },
    {
        "id": "cap:77eb9d51728edf64792a16748e0fd30c",
        "text": "С.Стругачев, Б.Барский, В.Андриенко "
    },
    {
        "id": "cap:32fcf7429ae327850e45835af57516dc",
        "text": "В.Андриенко, С.Сивоха, В.Зелинский во время сьемок."
    },
    {
        "id": "cap:5a761a769de93f28b83b537bed29fb5b",
        "text": "Оператор-постановщик Феликс Гилевич"
    },
    {
        "id": "cap:d8dddf37f1e5b5dcf945e595d0c119d7",
        "text": "Анатолий Дяченко и Михаил Церишенко"
    },
    {
        "id": "cap:282695688282cb0eced00940df9e374b",
        "text": "Александр Левит"
    },
    {
        "id": "cap:b5bf10b7e799c19bb8dfbc25e6712a51",
        "text": "Капитан Смолет"
    },
    {
        "id": "cap:cd3842bff7609dab52d3888f8c443697",
        "text": "В.Андриенко, В.Чигляев, А. Дяченко"
    },
    {
        "id": "cap:19654e1eb1abbc030430b01d804b5ccc",
        "text": "Билли Бонс"
    },
    {
        "id": "cap:bca08dc9a64c6b9f1fd03ad9471dc34c",
        "text": "Режиссер-постановщик - Давид Черкасский с преданным артистом"
    },
    {
        "id": "cap:edad87638ef28163c683b7f4ea3a19db",
        "text": "На съемочной площадке скетч шоу \"Веселі Усмішкі 2\", 11 летнего Владимира поздравил весь женский состав шоу."
    },
    {
        "id": "cap:ac726b16b2f675b7ca95fe41e1c0ab68",
        "text": "Гастроли в Москве"
    },
    {
        "id": "cap:be0d9e084ac54efd21e5634a2ea93748",
        "text": "Одесская филармония"
    },
    {
        "id": "cap:81fc632db053290925a2bf799ee0366c",
        "text": "Со зрителем спектакля, консулом Чехословакии"
    },
    {
        "id": "cap:0c00be35690d9ee8d2666e449feaad09",
        "text": "Валерий Чигляев в роли Швейка"
    },
    {
        "id": "cap:fbb0211499aa2deb1da4230bfce1cb32",
        "text": "Первая програмка спектакля"
    },
    {
        "id": "cap:087e0f35b590063a9556e3a5737027c3",
        "text": "Владимир Зелинский, Виктор Андриенко"
    },
    {
        "id": "cap:e1a0f8871720f2364c0556e829b5c4d0",
        "text": "прапорщик Половинко и капитан Ященко"
    },
    {
        "id": "cap:7e7bcd400b06fb1d5b537b17d08e49ff",
        "text": "Весь МЕНТалитет программы "
    },
    {
        "id": "cap:2275c4af556a277286195b54efe207c4",
        "text": "Создатель носов Д.Тупчий"
    },
    {
        "id": "cap:d96e4bf04632d76cab9ac2361866789e",
        "text": "Давид Черкасский на съемках"
    },
    {
        "id": "cap:ae2a8a888f9f761cbe2aeb5c7efce9ba",
        "text": "О. Федулов"
    },
    {
        "id": "cap:d00bffbdea08ee2a2f3c7c8ca2fa39c2",
        "text": "И.Письменный и В.Андриенко на сьемках"
    },
    {
        "id": "cap:c635c1816847b973c39ba452ade875d7",
        "text": "Тамара Яценко"
    },
    {
        "id": "cap:43bf36e495ee16175546e2efccd32530",
        "text": "\"Мошенник по неволе\""
    },
    {
        "id": "cap:c6e0c2eea905080a26f7365a5209f35f",
        "text": "\"От каданса до брейк-данса\""
    },
    {
        "id": "cap:fa1f782ce025bf67984823e45b9e1d12",
        "text": "\"Али-баба и 40 песен персидского базара\""
    },
    {
        "id": "cap:79565db460a2ebcc21fcf4a8bd6ffdb7",
        "text": "\"Сон в летнюю ночь\""
    },
    {
        "id": "cap:18eee31103efe2253e76add697e8cbb6",
        "text": "Главный художник театра Сергей Маслобойщиков"
    },
    {
        "id": "cap:1f8afe7b904d5bfbf2757d8a6a9283c2",
        "text": "Китай 1989 г."
    },
    {
        "id": "cap:bbfd3cd0091c3635fa362aebade40d5a",
        "text": "Финляндия 1990г."
    },
    {
        "id": "cap:ebe8e026a1b4703b656a54d3425d49d1",
        "text": "Монголия 1987г."
    },
    {
        "id": "cap:675904610759f4b1870d5278a0cd1a07",
        "text": "Москва 1989г."
    },
    {
        "id": "cap:d2f5be7dd4ad0ad1c4f4deac96c3664a",
        "text": "\"Раскрашенные мгновения\" Мюллер - В.Андриенко и С. Бурунов - Штирлиц"
    },
    {
        "id": "cap:ebebd79d7b9af40fef343e74c46dcb4c",
        "text": "Руководитель курса, Народный артист Украины Борис Петрович Ставицкий"
    },
    {
        "id": "cap:bb8dd57cc9121114e6f9d6bfb7022610",
        "text": "Танц кружок во дворце пионеров"
    },
    {
        "id": "cap:5b6eac604283db5cfcdad55d5fbed56c",
        "text": "\"Гость из космоса\" первая роль"
    },
    {
        "id": "cap:bfb0141c0f6438546ba4a2561fa7cfb8",
        "text": "Первый спектакль"
    },
    {
        "id": "cap:af2919a5dc15f9dc124d0cb1fe68c2b0",
        "text": "Ну... полное \"МАРАБУ\""
    },
    {
        "id": "cap:0d702ece9eedc2c70e35de8fa3506ff2",
        "text": "Виктор Андриенко, Валентин Опалев"
    },
    {
        "id": "cap:23d5e0967f56972b809a5097f98e1fdd",
        "text": "Виктор Андриенко в роли Кузькина."
    },
    {
        "id": "cap:28b483601855d7d562735daae0615109",
        "text": "Валерий Чигляев, Виктор Андриенко"
    },
    {
        "id": "cap:228eabb82e0d19259be2367e93e3bb55",
        "text": "В.Андриенко в роли Лейстреда"
    },
    {
        "id": "cap:d45aae02c8032c8f1910925ee48a4561",
        "text": "Братья Чигляевы В.Андриенко, Д.Тупчий и А. Никитченко "
    },
    {
        "id": "cap:d6550804d210a4079615037459f0a0f8",
        "text": "\"ПОЛНОЕ МАМАДУ\""
    },
    {
        "id": "cap:cebf21f97d66cbcefd35ee260399cc0c",
        "text": "Комедийный квартет"
    },
    {
        "id": "cap:0d100ac02fde54d159448e0c27bff3ff",
        "text": "Виктор Андриенко и Евгений Стычкин на съемках"
    },
    {
        "id": "cap:0dc17303a2667116ff651be811071f47",
        "text": "Игорь Письменный, Юрий Стыцковский и Виктор Андриенко"
    },
    {
        "id": "cap:d381fcd98723c1520daf14bda1e03023",
        "text": "\"Милицейская академия\", Харьков 2002-2005 гг."
    },
    {
        "id": "cap:fee6cc2822a8d4a7dcfb6cc68bbbe60f",
        "text": "Братья грабители"
    },
    {
        "id": "cap:6048575c6a9ef6fcbf2d25f8e6f736fb",
        "text": "В.Андриенко, О.Стемасов"
    },
    {
        "id": "cap:e1ac0cbc1bb8cfc621ebfbc962b278e0",
        "text": "Полковник - Василий Баша"
    },
    {
        "id": "cap:5e34ef1aa63932ff35622abe9ac14e76",
        "text": "Пастухов - Эдуард Верхотуров"
    },
    {
        "id": "cap:af1c9aa79fc840091a62ebe908705eb3",
        "text": "\"Кинорежиссер\" И.Мирошниченко"
    },
    {
        "id": "cap:d50b4a9f829950c5f3013521767f9599",
        "text": "Михаил Озеров, Виталий Лисичкин"
    },
    {
        "id": "cap:4e2f0ae3b3a0a6ddd26fbd8bfcd08cdc",
        "text": "Вячеслав Гиндин"
    },
    {
        "id": "cap:8c20cc8a10e524776576abebda09ae0b",
        "text": "А.Питриченко, В.Бендас"
    },
    {
        "id": "cap:2460821a19ec74e4eb1f6ce196325601",
        "text": "Василий Бендас"
    },
    {
        "id": "cap:348109b40208a4970cf48e2b9d26dac4",
        "text": "Валентин Опалев"
    },
    {
        "id": "cap:b2bf48e2129e1569a6b37c91431270cf",
        "text": "съемочная группа программы"
    },
    {
        "id": "cap:7fc32d5d09726a26d6437d27827c7bdb",
        "text": "Александр Ярема "
    },
    {
        "id": "cap:83eabfa1e6b646f9784b0c163ccc9db4",
        "text": "В.Опалев (Инспектор Петренко )"
    },
    {
        "id": "cap:7533674600b65aeb7615738790b2d339",
        "text": "Первое появление на телеэкране, 1982 год"
    },
    {
        "id": "cap:3f95b0ca93cd1abaa445706b20f3f705",
        "text": "Валентин Опалев, Виктор Андриенко "
    },
    {
        "id": "cap:847b8c3fcb3ebde8e3d9e249d0632a27",
        "text": "Твочесткий штаб Давида Черкаского"
    },
    {
        "id": "cap:85dcc70303f0bbe4d8bb7b91cb4cd392",
        "text": "Художник-постановщик Радна Сахалтуев на фоне персонажей фильма"
    },
    {
        "id": "cap:c99421a7ccf118d71a9bec84bf9e69ca",
        "text": "\"Мошенник по неволе\", Андриенко - трюкач"
    },
    {
        "id": "cap:7466b1001546771a8660e3f33451eeee",
        "text": "Главный режиссер театра - Виталий Малахов"
    },
    {
        "id": "cap:eebc42af85a0cb053b0f400a667b9e4c",
        "text": "\"Чудеса без чудес\", Афиша спектакля"
    },
    {
        "id": "cap:98c6232d567bc0c4d72304f6bc42f623",
        "text": "Малахов, Андриенко, Чигляев на репетиции"
    },
    {
        "id": "cap:2ffe21c94ffb4a0a1ab5a5dcd12c8901",
        "text": "\"Софокл, Шекспир, Брехт\""
    },
    {
        "id": "cap:611b925acaecb5d49172c3b4f90cd18a",
        "text": "\"Чудеса без чудес\""
    },
    {
        "id": "cap:766c0e2dd51232ab8c55f2c02ac924fe",
        "text": "1979-1986 год. Валерий Чигляев - моё второе \"Я\"... "
    },
    {
        "id": "cap:e9d545f0ac43bf6c11e4628bca7bf5ee",
        "text": "Билеты на первый спектакль"
    },
    {
        "id": "cap:08fd526dca8204877f4a6fd6f806d516",
        "text": "А.Филипенко, Ф.Гилевич, Д.Черкасский"
    },
    {
        "id": "cap:6c6bca2027fac28816a8aeddc4c09708",
        "text": "Педагог по танцу - Виктор Степанович Хребтов"
    },
    {
        "id": "cap:386d132b19c023b4a156d5e26eb20f39",
        "text": "1978 г. "
    },
    {
        "id": "cap:b17089184825ff92903a0dc0aa215a61",
        "text": "1987 г. с Михаилом Царишенко... "
    },
    {
        "id": "cap:aed44fdb962d6438b36aad5b5bbfd6ab",
        "text": "1988-90 гг с Виктором Иваненко..."
    },
    {
        "id": "cap:77908252d773853e95a0d039d6bd08ba",
        "text": "1991 г..."
    },
    {
        "id": "cap:e04ae9687eb9d977e6d826940263137e",
        "text": "Василий Бендас - партнер с 1998 года"
    },
    {
        "id": "cap:4acd55794f9abf8756b28350144cfe72",
        "text": "2006 г."
    },
    {
        "id": "cap:3273e574329d55eccd71ee0634683b77",
        "text": "Студент А. на строительстве будущего \"Майдана\". 1976 год"
    },
    {
        "id": "cap:ab373e56cb1207c0dedd3f2f856d1dae",
        "text": "1977 г."
    },
    {
        "id": "cap:71d27bafdfd0c3fb2b2872503eecfb95",
        "text": "Виктор Приходько, Виктор Андриенко"
    },
    {
        "id": "cap:e77a8ae5cae997eca14824aa5252b356",
        "text": "Режиссер фильма - Виктор Приходько"
    },
    {
        "id": "cap:9f01efee54dedf9cad2478ee8b06abb3",
        "text": "...первая роль и первый крупный план Виктора Андриенко..."
    },
    {
        "id": "cap:bada014fa1d3c4d439a3ae40371324eb",
        "text": "Сергей Иванов в роли сержанта Цибули"
    },
    {
        "id": "cap:ff4e0b23f030c6e0dee5d9dba9694150",
        "text": "С концертами от \"Дома Актеров\" в Чернобыльскую зону 1986-1988гг..."
    },
    {
        "id": "cap:573b5b274f93c66878bc710062ef3f21",
        "text": "Этап 1"
    },
    {
        "id": "cap:7ba7dfc9a14583b48c4a6107112df5a4",
        "text": "Этап 2"
    },
    {
        "id": "cap:3641656d9d522a749da7879c9472d8ec",
        "text": "Этап 3"
    },
    {
        "id": "cap:26eb252d6ec6eb0f2922a93f09d3071a",
        "text": "Этап 4"
    },
    {
        "id": "cap:eb2f9f1aaefa353e2f4da7458acc02e6",
        "text": "Этап 6"
    },
    {
        "id": "cap:5e2c0b797e35842c3ce1436f230efdd1",
        "text": "Этап 7"
    },
    {
        "id": "cap:1b4f20861f88d2758e4e5b8850975e45",
        "text": "Этап 8"
    },
    {
        "id": "cap:09fef74baa5c6fe068a8d7636519b0ed",
        "text": "Этап 5. Юрий Коваленко на озвучке"
    },
    {
        "id": "cap:05589dbc05951bdd3fa0057c7e0d9fd9",
        "text": "Этап 5. Игорь Мельничук"
    },
    {
        "id": "cap:d60fe4744bd7c70c3832ec0fb9531519",
        "text": "Этап 5. Павел Крахмалев"
    },
    {
        "id": "cap:69821fc70c6b88477a91ff7674ab78a2",
        "text": "...первый опасный трюк..."
    },
    {
        "id": "cap:7a550676267b11ebe88230c935942a65",
        "text": "Виктор Андриенко, Марина Могилевская"
    },
    {
        "id": "cap:bf32d254d75caab75afe6862358cf628",
        "text": "Шефа угоньщиков самолета"
    },
    {
        "id": "cap:1393cf73c261daf3f3d7319e52816fe6",
        "text": "Валентин Опалев, Алексей Акопян"
    },
    {
        "id": "cap:f01c2303d9d7bbe548f8dce21783c156",
        "text": "Борис Барский"
    },
    {
        "id": "cap:1d963182e5a7ca3cd19537ca4b0465a0",
        "text": "Петр Кузнецов"
    },
    {
        "id": "cap:d0954965e40e7c445e7eccbd2c935014",
        "text": "Виктор Иваненко"
    },
    {
        "id": "cap:245a7ac02690ecc9cbc64d5a70d6e6ea",
        "text": "Лесь Заднепровский"
    },
    {
        "id": "cap:67af6852a2221d130cf2f683219e0aec",
        "text": " Георгий Делиев"
    },
    {
        "id": "cap:83e4cd98d0bc24d7cc2019f81a22967a",
        "text": "Ани Лорак заблудилась"
    },
    {
        "id": "cap:413c7ce0ac1d53a42d8cef4b6c0f9a9c",
        "text": "Анатолий Дяченко"
    },
    {
        "id": "cap:bdfbdc1cf2d386a6c07eda5b5a59ae1f",
        "text": "Оленька (В.Бендас)"
    },
    {
        "id": "cap:8367ce81fb1c67cb9631dbf1079e94c8",
        "text": "Режиссер сериала Юрий Стыцковский "
    },
    {
        "id": "cap:2c6a6cf5f51498f267f1cc6569ab7ad9",
        "text": "Антон Колесников"
    },
    {
        "id": "cap:411502b3e33408a022fb16c297a6ce69",
        "text": "Группа румынских бухалтеров под управлением Сивохи"
    },
    {
        "id": "cap:494fac5317784923401629640681eada",
        "text": "Николай Луценко"
    },
    {
        "id": "cap:024b4bca8d75e2f63c860e0d84d3289a",
        "text": "Полина Войневич"
    },
    {
        "id": "cap:30a4ca552dd0b8475d427aed3bfd1b69",
        "text": "Александр Филатов - председатель киевской лиги каскадеров.                                                                                                 "
    },
    {
        "id": "cap:0d24cb8c91768abfde95e598bfd294f5",
        "text": "Антонина Винник"
    },
    {
        "id": "cap:a1c3eeb4deccb241261a000db7fef7a4",
        "text": "1990-1996 гг. - одинокий \"эстрадный волк\"..."
    },
    {
        "id": "cap:873cdd975c6dd6f48293da4120957ed2",
        "text": "В.Андриенко, В.Бендас"
    },
    {
        "id": "cap:26215701b8953ccfeb7f6fb921377282",
        "text": "Гениальный Холмс"
    },
    {
        "id": "cap:d0a9a4b503ffd9b4a3f053fa599c46b8",
        "text": "Андриенко без грима"
    },
    {
        "id": "cap:74b8cc0c9629e52fb8fa690f7fa275d4",
        "text": "Яша Левинзон"
    },
    {
        "id": "cap:4f31f688f73227db96bdef4a108d2553",
        "text": "Лолита и Саша Цекало"
    },
    {
        "id": "cap:dca08397204a8b7c4f0d3b06ea966539",
        "text": "Володя Бистряков"
    },
    {
        "id": "cap:1cbc62c4932db9004d44ff887c547bd2",
        "text": "группа \"Mad Heads\""
    },
    {
        "id": "cap:f2bab15f496e3a6fdbcef2503ae31444",
        "text": "Таісія Повалій"
    },
    {
        "id": "cap:2a8eb5addafed9b4aa2765f7f6d18d4c",
        "text": "Сергей Сивохо и его имеджмекеры"
    },
    {
        "id": "cap:9f9808aab9f0242ed30d98ad86d8c5fa",
        "text": "Шоу прышэлэпктовых"
    },
    {
        "id": "cap:bb333cdfc6201776bc236c382109d020",
        "text": "В.Андриенко в роле - ЧАПЫ"
    },
    {
        "id": "cap:b6f287eb1ff2d8e78811ddc6568a5046",
        "text": "Шерлок Холмс и доктор Ватсон "
    },
    {
        "id": "cap:97c513dc8a3465c723bb0693715b3550",
        "text": "Гениальный Холмс и Миссис Хадсон"
    },
    {
        "id": "cap:22b87ef0d89da878563fe6f21929ac3c",
        "text": "EL.Кравчук, В.Андриенко"
    },
    {
        "id": "cap:00d15b52213034e13e7504a2bc327284",
        "text": "Награждение Э.Верхотурова (телешоу \"ЧИЗ\")"
    },
    {
        "id": "cap:74d9583e2ab1635700911e0fd06231c1",
        "text": "Василий Бендас участник гонок"
    },
    {
        "id": "cap:16c7d39bc055c90633a323bad69eebf0",
        "text": "А.Питриченко, В.Андриенко"
    },
    {
        "id": "cap:e5f16dedc169eb470f65e20fc3e3b32f",
        "text": "Звезды с продюсором фильма В.Приходько"
    },
    {
        "id": "cap:5924b6db6f80b4ebd5c6c9a6c8e3661f",
        "text": "Людмила Шпиталева"
    },
    {
        "id": "cap:3f9d89d447d732290cb68f22e60ebf28",
        "text": "Т.Яценко, П.Кузнецов"
    },
    {
        "id": "cap:7e5c9efe3b77e2c5d07d6ca476da1c83",
        "text": "Без сменные ведущие В.Андриенко, В.Опалев, И.Бойко"
    },
    {
        "id": "cap:a9d9bc3bbe9d46edd74c3d28f97d1201",
        "text": "Сочи 1988г."
    },
    {
        "id": "cap:5ed6b02978184af567debbc3d2d23c45",
        "text": "Б.Калашников, Д.Бабаев, Д.Черкаский, Н.Гудзь"
    },
    {
        "id": "cap:9810508ea1ca32d754ccdc4b3fc5e1d9",
        "text": " 2001-2004 ежегодный фестиваль юных пожарников..."
    },
    {
        "id": "cap:9dbdb7683cf5bde9aa1d6f6a33d3757f",
        "text": "1996-1998гг. с Генадем Корженко..."
    },
    {
        "id": "cap:befbf688cd338aacc6f49524a6782780",
        "text": "\"Шоу Довгоносиков\" на сцене Харькова 1997г..."
    },
    {
        "id": "cap:d42325f4b7d5314e2e64030febc648e6",
        "text": "1996-1999гг. с Валентином Опалевым"
    },
    {
        "id": "cap:02d07e3c4bf71772c41a6e869f386db8",
        "text": "Звезды своего дела!"
    },
    {
        "id": "cap:caafcce34d9d33bb6db1c8c6432ef7ff",
        "text": "Первый выход на эстраду 1973 год..."
    },
    {
        "id": "cap:8fa5b5f05a05c2af863f984625ff511e",
        "text": " С клоун группой \"МИМИРИЧИ\" Крым-Ужгород 1999г..."
    },
    {
        "id": "cap:0e131dd1aed9f4e8f9fb68e044063593",
        "text": "Кого только не встретиш на гастролях даже... Жана Рено"
    },
    {
        "id": "cap:129bfad27ccc53602dc5776918a79ff3",
        "text": "Открытие фестиваля."
    },
    {
        "id": "cap:99824dc362b5c1e2b7a00989cd1bb077",
        "text": "СТЭМ \"Ураган\" из г.Львова"
    },
    {
        "id": "cap:77cb8715d07a18c329e088593a234063",
        "text": "СТЭМ \"FM\" из г.Запоржье"
    },
    {
        "id": "cap:1719b971ee0ac7cfa8a17a13608f98ec",
        "text": "СТЭМ \"Солнышко\" из г.Запоржье"
    },
    {
        "id": "cap:d94d26d8a82abc85e935917c5b7cd633",
        "text": "СТЭМ из Белорусии"
    },
    {
        "id": "cap:236ebe7ab6850bbf64fba0d046c8cfed",
        "text": "СТЭМ \"Будильник\" г.Запоржье"
    },
    {
        "id": "cap:a2ae18948bcf6a51e6542970235ca020",
        "text": "СТЭМ из г.Полтавы"
    },
    {
        "id": "cap:20a30d64b2499547f9d3f7ce2c099a66",
        "text": "Жюри: В.Бендас, Е.Чепурняк, А.Пугачев"
    },
    {
        "id": "cap:dc93b91af2402c39cfa2cf1dd255b3a8",
        "text": "Член жюри О.Григорьев"
    },
    {
        "id": "cap:9c0ed5e0264bd250cfca10fc6dd0f505",
        "text": "Закрытие фесиваля В.Андриенко и В.Бендас"
    },
    {
        "id": "cap:052f758644b8fb75c2a8af3c087c7344",
        "text": "Вручение Гран При СТЭМу г.Москва"
    },
    {
        "id": "cap:d96b93c2d2c9bbca398d9884fd550886",
        "text": "Без С.Б.Беликова, ректора НТУ, фестиваля бы небыло."
    },
    {
        "id": "cap:ea6f25e105b23b7bacc0389926d4adc4",
        "text": "Основатель \"Гонок на выживание\" Сергей Тимашов"
    },
    {
        "id": "cap:2a629baccdd5e43a715618dd3696ab3a",
        "text": "В.Андриенко, О.Григорьев на гонках. "
    },
    {
        "id": "cap:9a6fa9537128be02c35012e2f99dc3d9",
        "text": "Олег Григорьев награждает победителей"
    },
    {
        "id": "cap:7edfbe21865824448a526855178d884e",
        "text": "Василий Бендас после финиша"
    },
    {
        "id": "cap:7a975bfb52848b9b0da493d513872d08",
        "text": "Олег Григорьев, Виктор Андриенко, Сергей Тимашов (Скорпион). "
    },
    {
        "id": "cap:c9979d1d6931538129d3a1d921fcb6ed",
        "text": "Виктор Андриенко в образе Тараса Шевченко"
    },
    {
        "id": "cap:d8e24bd42fd980fa93ecc71e4db11fff",
        "text": "Ю.Стыцковский, В.Андриенко, И.Письменный"
    },
    {
        "id": "cap:eb2faffeb2632a87f18473013aaa2449",
        "text": "Виктор с организаторами кинофестиваля после вручения ему \"золотого летающего слона\""
    },
    {
        "id": "cap:25d76ba2f573949e0f10fcf07f4a585e",
        "text": "Участник от Украины Роман Стопчак (справа)"
    },
    {
        "id": "cap:b3dae8d6ce6950857c9b5a1e1ab3262c",
        "text": "Виктор Андриенко и Илья Шакунов во время сьемок."
    },
    {
        "id": "cap:947519d93dfec34e3e9bc3b856dca95e",
        "text": "Е.Ганелин, В.Андриенко, Н.Татаренков"
    },
    {
        "id": "cap:9b805c00768e6d5e701239d94064fdb6",
        "text": "Виктор и Илья с режиссером Иваном Войтюк перед съемкой"
    },
    {
        "id": "cap:1abc6b015a1f33412592ba6756178c9b",
        "text": "Оператор: Виталий Запорожченко"
    },
    {
        "id": "cap:e01e9f0006663da67878124c8c8d47e4",
        "text": "В.Андриенко, В.Потапенко"
    },
    {
        "id": "cap:acbfd600c831619be040b55f0b109c30",
        "text": "пародия на теле-ужастики"
    },
    {
        "id": "cap:c913648e22616be7828f1eb5374051e9",
        "text": "\"Няня апокалипсиса\""
    },
    {
        "id": "cap:7f8eb606435b51130e8751ff6877335c",
        "text": "пародия на \"Дом 2\""
    },
    {
        "id": "cap:0bfd334e74984f825d70e5e4a725dfe8",
        "text": "пародия на ролик \"Билайн\""
    },
    {
        "id": "cap:60a2f7d9b065f4d51a2180300581c66c",
        "text": "пародия на \"Ночной дозор\""
    },
    {
        "id": "cap:854eb23bf32184ce9f856e51fb7433bd",
        "text": "\"Дом 2\""
    },
    {
        "id": "cap:88670b942e02458bf07ca68d80fc927d",
        "text": "режиссер проекта Алексей Кирющенко "
    },
    {
        "id": "cap:74cfe1bf4df2a068aedf8ef169dff1fb",
        "text": "\"Ледниковый периуд\""
    },
    {
        "id": "cap:a23a0c44536510b1bdf296e0a0f0bb09",
        "text": "Игорь Письменный"
    },
    {
        "id": "cap:adfe321b82526cdb347a1fae6b2d3b34",
        "text": "Иван Урган, Александр Цекало"
    },
    {
        "id": "cap:cc975a784aec0e074a633008046cbf26",
        "text": "В.Андриенко и И.Письменный"
    },
    {
        "id": "cap:82fe38235a9a40400ebc5427204f2c8f",
        "text": "Дмитрий Климашенко"
    },
    {
        "id": "cap:b89c1f9f32aeba5e47fd2a77d5fa9a0a",
        "text": "Борис Моисеев"
    },
    {
        "id": "cap:e1e0efe82b0cbac1226526d79813a3a5",
        "text": "Д.Черкаский и В.Андриенко на съмках \"Острова Сокровищ\" 1986 г."
    },
    {
        "id": "cap:44b5442370e13e13b6ca97d3f93af9d0",
        "text": "Давид Черкаский "
    },
    {
        "id": "cap:21791bac718290e79b187beeb10fcd82",
        "text": "Василий Бендас "
    },
    {
        "id": "cap:d4ba3a9c1710d8e5e434ea410936615e",
        "text": "Виктория Булитко"
    },
    {
        "id": "cap:28129925ec2e6e710bf9e0a562bacc4c",
        "text": "Ольга Кияшко"
    },
    {
        "id": "cap:b1a7f1b7f086749492b4a1ebadf21452",
        "text": "Виктор Андриенко в \"Большой Разнице UA\""
    },
    {
        "id": "cap:ea929cd4a7c3ad9921eb88b5c18c0de6",
        "text": "Александр Пугачев"
    },
    {
        "id": "cap:6a9bbf8e488e8d0a031ce2d4c7eaa53b",
        "text": "Игорь Тимошенко"
    },
    {
        "id": "cap:237c4a70577b459cc535a4e548004842",
        "text": "Веселі Усмішки - та їх герої"
    },
    {
        "id": "cap:445c5ed733ee020a27af027494c53a46",
        "text": "А.Пугачев, В.Андриенко в сериале \"Веселі Усмішки\""
    },
    {
        "id": "cap:32cfb06510f01512e4677606e48e6859",
        "text": "А.Пугачев, О.Кияшко "
    },
    {
        "id": "cap:090ad5fe8d49b33c853db9c766db3bc5",
        "text": "На съемочной площадке"
    },
    {
        "id": "cap:1a39f7cee2a3ce03480e2797336cf3c7",
        "text": "Вечеслав Гришечкин "
    },
    {
        "id": "cap:8e506b495a2ab31f627b4ab0b84d3078",
        "text": "Владимир Комаров"
    },
    {
        "id": "cap:db0181df107123a877d269319809a2eb",
        "text": "Бим - герой фильма "
    },
    {
        "id": "cap:badcff524eb6b1d86b9182f717bf4896",
        "text": "Юрий Стыцковский"
    },
    {
        "id": "cap:3d3bb96a5595707e503630dce1f833db",
        "text": "В.Андриенко с партнером по кино бизнесу "
    },
    {
        "id": "cap:fbf0101bce81c028e494e6205cb902d0",
        "text": "В.Ямбурский на сьемках фильма"
    },
    {
        "id": "cap:6b054e6c23b90f34c78d91711a12b3c3",
        "text": "2008 г."
    },
    {
        "id": "cap:77608f57e170ed470e20ec7c85a8f24c",
        "text": "Телеконцерты в \"95 квартале\""
    },
    {
        "id": "cap:a35242ad13a480df113f67eac9da2c61",
        "text": "\"Золотой гарбуз\", отчет \"95 квартала\" за 2004 г."
    },
    {
        "id": "cap:1305155526ab3284ade650cbd0ce0d95",
        "text": "С.Сивоха, В.Зелинский, В.Андриенко (отчет \"95 квартала\" 2004г.)"
    },
    {
        "id": "cap:4bdfc92b4422e6742dc78cc6344db068",
        "text": "Армен Джигарханян в роли Беримора"
    },
    {
        "id": "cap:d66fa5f0632b7e16b69e0b5e92b77901",
        "text": "Вадим Жук в роли Маркиза де Сада"
    },
    {
        "id": "cap:d19ecf78032a549361f86cb9a804501e",
        "text": "В.Андриенко, И.Кистол. С.Бурунов "
    },
    {
        "id": "cap:8688f2a9ca0f4609a637b9ceb10c412a",
        "text": "...теже - С.Бурунов, И.Кистол, В.Андриенко "
    },
    {
        "id": "cap:3fde2ae415dc9098b6ce0f80546f11f8",
        "text": "Виктор Андриенко и Елена Стефанская"
    },
    {
        "id": "cap:e086daae13b5e7c1a5a7bfd19b358d4e",
        "text": "Режиссер фильма Наталья Марченкова"
    },
    {
        "id": "cap:a0c828c8c8c14a6a45ba31460f4c1083",
        "text": "Виктор Андриенко и Валентин Опалев (на сцене)"
    },
    {
        "id": "cap:a21b6207ac3a7d08c2b3a2980d70e0f4",
        "text": "Урок танца 1977 г. Виктор Андриенко с Николаем Луценко "
    },
    {
        "id": "cap:b37fbbb1a4d64bd79c745ac1ee6e98bd",
        "text": "В.Андриенко, С.Сивохо, В.Зелинский"
    },
    {
        "id": "cap:7ca98a1fdae478552bd497f6fd187a0c",
        "text": "За кулисами: Ю.Фалеса, В.Павлик, И.Лыхута, Г.Кричевский, В.Андриенко"
    },
    {
        "id": "cap:eb1185f3c93400e1a8369bd09232c196",
        "text": "На съемках весна лето 2008г."
    },
    {
        "id": "cap:d8cf88179095c56e10c7e4b5a03806eb",
        "text": "Шоу Довгоносиков 1996г."
    },
    {
        "id": "cap:e673ef77374a8ad3b5a2cdc94b6c0776",
        "text": "Вадим и Армен Джигарханян \"Безумные Макароны\" 1992 г."
    },
    {
        "id": "cap:6ab8f8872a8ffaabf670aba356a344aa",
        "text": "Партнеры с  В.Андриенко с 1987 г."
    },
    {
        "id": "cap:f169e88147df35f031517d8cca59a42d",
        "text": "С Виктором Андриенко в Запорожье на съеках \"Тараса Бульбы\" 2008 г."
    },
    {
        "id": "cap:eb12b6a7ce149f442e58df5cdc3c8d24",
        "text": "Режиссер фильма Александр Итыгилов"
    },
    {
        "id": "cap:76f8916b1c84457d819760f83626f216",
        "text": "Сергей Пархоменко (Серега), "
    },
    {
        "id": "cap:686d3ccd149e8041e548f1c8fdd871dc",
        "text": "Маша Малиновская \"Блондинка в накауте\""
    },
    {
        "id": "cap:7a992cd212b38a925304d74231a4a673",
        "text": "Михаил Полицеймако"
    },
    {
        "id": "cap:5936b28d3783b7a004a98eb5c3209146",
        "text": "Остап Ступка"
    },
    {
        "id": "cap:361c9fc9bb8ca83a0c3d96db10449699",
        "text": "Сергей Гаврилюк"
    },
    {
        "id": "cap:14da1d9043d36510383a2b63b1ba6719",
        "text": "Оператор Ал. Степанов"
    },
    {
        "id": "cap:3ff2638ca2bc2e40226f2a1275876d11",
        "text": "Сосед и его семья."
    },
    {
        "id": "cap:aa640c0e035cc71dda9b3b7ed75b9e71",
        "text": "пародия на программу \"Усадьба\""
    },
    {
        "id": "cap:3ccaa5484263c7aebdff5471db7f0691",
        "text": "режиссер Д.Дяченко и В.Андриенко"
    },
    {
        "id": "cap:f11a29a828474bd9c29114c9491a6333",
        "text": "пародия на программу \"Тачка на пркачку\""
    },
    {
        "id": "cap:5f8cadea99ea66a948a9e07049914c64",
        "text": "пародия на передачу \"Давай поженимся\""
    },
    {
        "id": "cap:52434d974715ce9c5d92311bf5c23027",
        "text": "пародия на фильм \"12\""
    },
    {
        "id": "cap:ae3ee805976086255a7df75c52f81c61",
        "text": "пародия на криминальные сериалы"
    },
    {
        "id": "cap:06729cecb7ee649a53bf94277006945a",
        "text": "пародия на сериалы"
    },
    {
        "id": "cap:a38d013c211803874e8e1df6c87b4067",
        "text": "пародия на программу \"Здоровье\""
    },
    {
        "id": "cap:3f532e67d9f1325134cbbf9100da9ff4",
        "text": "пародия на программу \"Прожектор ПерисХилтон\""
    },
    {
        "id": "cap:a0bc29d553f762bfd515cb28203bb25c",
        "text": "пародия на программу \"Неочевидное но факт\""
    },
    {
        "id": "cap:67e123925a1377128bdfaabc03f55846",
        "text": "Виталий Малахов - Главный режиссер Киевского \"Театра на Подоле\""
    },
    {
        "id": "cap:e20bb166d517b5ef19715a0554a934a7",
        "text": "Владимир Комаров, Виктор Андриенко на съемках"
    },
    {
        "id": "cap:29e5d56061d108c817dd454b3e97f99f",
        "text": "Пью поет песню о мальчике Бобби голосом Виктора Андриенко"
    },
    {
        "id": "cap:e34743626df72e94ea7a96ea9d5761f8",
        "text": "Пародия на Богдана Ступку"
    },
    {
        "id": "cap:be6f0fe6610b065dc6af1e4a20aa6605",
        "text": "Большая разница"
    },
    {
        "id": "cap:8857bfc83a45114876806cdb84a83cfb",
        "text": "\"12\" стульев - Остап Бендер"
    },
    {
        "id": "cap:6e363b1e8554687aa10309d0f219e97d",
        "text": "С Игорм Кистолом в \"Большой разнице\""
    },
    {
        "id": "cap:e804fbfa5085cb385dc2b8bed60dd523",
        "text": "\"Большая разница\""
    },
    {
        "id": "cap:fabc0f463777cd01f130727f65f40f37",
        "text": "С Нонай Гришаевой \"Большая разница\""
    },
    {
        "id": "cap:4e8a61db6e5a7d6f439a6d10bc52bceb",
        "text": "\"Большая разница\" пародия на \"12\""
    },
    {
        "id": "cap:dfd094ff23fec6c020e595dc44370a4d",
        "text": "С Виктором Андриенко на съемках"
    },
    {
        "id": "cap:926811c1639a647827851e5e2c5590dc",
        "text": "Пародия на программу \"Кривое зеркало\""
    },
    {
        "id": "cap:f03692e93ea7e830ddb0d51f92834ac9",
        "text": "\"Веселая Хата\" роль Контактера"
    },
    {
        "id": "cap:0183ed0a81f8b20a893c456e997a31fd",
        "text": "на съемках \"Веселой Хаты\""
    },
    {
        "id": "cap:5fe4e4453b1bdfcbcd4dfec5ac7fd431",
        "text": "Пародия на программу \" Сам себе режиссер\""
    },
    {
        "id": "cap:149b6334387dc8c2a1bf0eb5cf5bca3a",
        "text": "Жюри среди лауриатов фестиваля"
    },
    {
        "id": "cap:287e3e11c9d492018c8e6a5380271a0a",
        "text": "«калики перехожие» - В. Андриенко, В.Кисарова и А. Лобанов"
    },
    {
        "id": "cap:8b9f56d09a4c81868c469450d611e3b8",
        "text": "Гоша Куценко - Илья Муромец"
    },
    {
        "id": "cap:2a40824eb4143b5e3a8ad0ee36919867",
        "text": "Дележ «гонорара» с печенежским ханом (Игорь Кистол)"
    },
    {
        "id": "cap:6443f346866c01b95fa41fd800b8ec5c",
        "text": "пародия на сериал \"Кармелита\""
    },
    {
        "id": "cap:6710adabb30a4d3628de106631a8e7d6",
        "text": "пародия на сериал \"Кармелита\" В.Андриенко (Баро)"
    },
    {
        "id": "cap:18ab42eb875c4d2b883d477eef501991",
        "text": "пародия на передачу \"Пока все дома\""
    },
    {
        "id": "cap:e4eba8e930c4e94e7363f19c5588edec",
        "text": "Режиссер: Иван Вотюк"
    },
    {
        "id": "cap:6b2c889ab368e4fa30895db1dd33242b",
        "text": "С режиссером \"Большой разницы\" Юрием Владовским"
    },
    {
        "id": "cap:a8848df35432b79d3812f5545f316261",
        "text": "\"Школа Бюрократов\" Михаил Ефремов и Александр Лобанов"
    },
    {
        "id": "cap:94a54267e9aee207dad46e204cbc3da8",
        "text": "\"Иван Грозный комисует своего сына\" - И.Кистол, В.Кисаров"
    },
    {
        "id": "cap:6b659f4c6f37f6fd077ccdac3f21f5d1",
        "text": "Фотопробы к фильму"
    },
    {
        "id": "cap:11e2e73ffc03f1789547c1617cb4befb",
        "text": "Алексей до съемок у Андриенко..."
    },
    {
        "id": "cap:902a1e26f908effa2cbed3e379f41886",
        "text": "...и после."
    },
    {
        "id": "cap:5cf0dafad8ade91828e308bbf8066345",
        "text": "Вячеслав Манучаров без грима"
    },
    {
        "id": "cap:f9d71fbbd6e5163c9231f095364895a0",
        "text": "еще одна творческая удача..."
    },
    {
        "id": "cap:7fb4efbe084cdb1dc3ca726281ba7ab6",
        "text": "\"Зверев\""
    },
    {
        "id": "cap:6d220cda1b6447d68a185a38e8e30a6c",
        "text": "С В.Кисаровым в пародии на фильм \"Мясо\""
    },
    {
        "id": "cap:056a004d71fa6e8bb05b60817c134b1b",
        "text": "И.Кистолом в пародии на \"Модный приговор\""
    },
    {
        "id": "cap:e48a067b79b5ece13065aecbf3e7c245",
        "text": "Пародия на сериал \"Затерянные\""
    },
    {
        "id": "cap:165569284529a174479f817cb5b9ebc1",
        "text": "в образе А.Друздя - пародия на передачу \"Что? Где? Когда?\""
    },
    {
        "id": "cap:41c7a5ed4595d2b14ed18c1faa87a552",
        "text": "С С.Буруновым в образах - А.Бендаря и В.Жендарева"
    },
    {
        "id": "cap:2d6bc0c8eebe0af2289849f38056bdea",
        "text": "С В.Андриенко (внизу) на съемках \"Большой Разницы\""
    },
    {
        "id": "cap:a7fdc32b4574e80119f8a89997cab3b7",
        "text": "С А.Олежко (слева) пародия - \"Матрица\" 1920 г."
    },
    {
        "id": "cap:7293c15beb844d60bf22f983c3f9f327",
        "text": "У этих разных лиц есть одно общее - это имя Сергей Бурунов"
    },
    {
        "id": "cap:1a5a40653770b13190cdada38428fd74",
        "text": "Пародия на фильм \"Тарас Бульбу\" в \"Большой разнице\""
    },
    {
        "id": "cap:7a4da868bcc473fa123ee61b886a7272",
        "text": "Владимир Кисаров"
    },
    {
        "id": "cap:2a7775e69276337ed1e4c270fa9effac",
        "text": "Пародия на фильм \"Адмирал\" в \"Большой разнице\""
    },
    {
        "id": "cap:d1ad0869ae4b8d8fd6198ee5d9df3a21",
        "text": "Виктор Андриенко, Александр Олежко, Маруся Зыкова"
    },
    {
        "id": "cap:6fa5d0819c023be71a285ea8d8cb845a",
        "text": "Ведущие \"Великой різниці\" Иван Ургант, Александр Цекало"
    },
    {
        "id": "cap:2cedd666e323f988e2bf6ecdf92df515",
        "text": "Светлана Галка и Виктор Андриенко в \"Большой Разнице\""
    },
    {
        "id": "cap:f2da0283f6984ad7b5983715adfe316e",
        "text": "Один из авторов \"Великой різниці\""
    },
    {
        "id": "cap:cbb68099f180b70a96fb5c99ffb2c711",
        "text": "Cветлана Галка"
    },
    {
        "id": "cap:2ddcf1139a4f807dc6885848e15cadcd",
        "text": "Пародия на \"Место встречи изменить нельзя\""
    },
    {
        "id": "cap:058b66be00b715189a7e8339209b3c96",
        "text": "\"Рім має таланти\" Вячеслав Гиндин и Игорь Арнаутов"
    },
    {
        "id": "cap:dbb2387e287eb2d3a21713cd75aaf565",
        "text": "Виктор Андриенко в пардии на \"Козаков 95 квартала\""
    },
    {
        "id": "cap:c5e271b63c97b26575887a01641ba0f6",
        "text": "Аватар по украински..."
    },
    {
        "id": "cap:86e769e3017af747f7fed14e18c6efe6",
        "text": "пародия на \"Фабрику Звезд UA\""
    },
    {
        "id": "cap:d497922022fccb695df013c15b943c27",
        "text": "Труппа украинской Разницы"
    },
    {
        "id": "cap:eb2598409983b14cc1f75c4cadd2de02",
        "text": "На премьере мюзикла с Ларисой Долиной и автором Максим Дунаевский"
    },
    {
        "id": "cap:0b84389424ab292a9cad267b100cefe0",
        "text": "Мюзикл \"Любовь и Шпионаж\""
    },
    {
        "id": "cap:ede04ed6fc538fb8ead25b22ff92a5bd",
        "text": "Киевский Театр Эстрады 1980 г."
    },
    {
        "id": "cap:fe96bb2e592ad2b8c351c170576e4227",
        "text": "Главный режиссер Виталий Малахов, Виктор Андриенко, Валерий Чигляев 1981 г."
    },
    {
        "id": "cap:50cc106630c4ffb4c24f376b6fa7c1c3",
        "text": "кадр из фильма."
    },
    {
        "id": "cap:59497f1eecb2a176feeaaed1bd02bb89",
        "text": "Олег Федулов \"Подвиг Одессы\" 1984 год."
    },
    {
        "id": "cap:5d0337ae713ae044d09d822d99bd0dae",
        "text": "Владимир Янченко и ведущий фестиваля Виктор Андриенко"
    },
    {
        "id": "cap:fad9f18deeaf2d46c9d6da796dbd2765",
        "text": "Сусиков (Виктор Андриенко) и Маша (Мария Дюжева)"
    },
    {
        "id": "cap:df26bdd0ceb2c3d8047b5fa33085b375",
        "text": "Кадр из фильма"
    },
    {
        "id": "cap:603c9143ffe28ef956f76ae620ccc07c",
        "text": "пародия на трилогию \"Сумерки\""
    },
    {
        "id": "cap:fadf9483e2e72315236e3cfcb798a68a",
        "text": "\"Жестокие Игры\""
    },
    {
        "id": "cap:b7bfcdb08386a86786d69f1bf0088663",
        "text": "Пародия на сериал \"Ефросинья\""
    },
    {
        "id": "cap:6655687a9fc1c269a04d77b4e2e8a87c",
        "text": "Пародия на передачу \"Городок\""
    },
    {
        "id": "cap:ca28c4f7683898b7e77bf44a0cfafc25",
        "text": "\"Сумерки\""
    }
]